<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# === REDIRECT SPESIFIK URL LAMA YANG SUDAH RANKING ===
# Harga bore-pile-Xcm.html → harga/bore-pile/Xcm/
RewriteRule ^harga/bore-pile-30cm\.html$ /harga/bore-pile/30cm/ [R=301,L]
RewriteRule ^harga/bore-pile-40cm\.html$ /harga/bore-pile/40cm/ [R=301,L]
RewriteRule ^harga/bore-pile-50cm\.html$ /harga/bore-pile/50cm/ [R=301,L]
RewriteRule ^harga/bore-pile-60cm\.html$ /harga/bore-pile/60cm/ [R=301,L]
RewriteRule ^harga/bore-pile-80cm\.html$ /harga/bore-pile/80cm/ [R=301,L]

# Galeri: /galeri/ tidak punya index.html, redirect ke galeri/gallery/
RewriteRule ^galeri/?$ /galeri/gallery/ [R=301,L]

# Redirect .html to trailing slash (/) — generic
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(.*)\.html\ HTTP/
RewriteRule ^(.*)\.html$ /$1/ [R=301,L]

# Redirect index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /+(.*)index\.html\ HTTP/
RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

# Add trailing slash if not a file and doesn't have one
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(.*)/$
RewriteRule ^(.*)$ /$1/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    # Content Security Policy (CSP)
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://analytics.ahrefs.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com; font-src 'self' data: https://cdnjs.cloudflare.com; connect-src 'self' https://analytics.ahrefs.com https://www.google-analytics.com https://stats.g.doubleclick.net https://region1.google-analytics.com; frame-src 'self' https://www.google.com;"

    # Keamanan Tambahan
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
