# Agung Perkasa Borepile - .htaccess untuk Hostinger (Apache/LiteSpeed)
# Redirect URL lama (folder-style) ke URL baru (.html)

RewriteEngine On

# ============================================================
# URL LAMA (flat-style) -> URL BARU (folder-style)
# Ini untuk Google dan pengunjung yang masih pakai link lama
# ============================================================
RewriteRule ^jasa/bore-pile-jakarta\.html$ /jasa/bore-pile/jakarta.html [R=301,L]
RewriteRule ^jasa/bore-pile-bekasi\.html$ /jasa/bore-pile/bekasi.html [R=301,L]
RewriteRule ^jasa/bore-pile-bogor\.html$ /jasa/bore-pile/bogor.html [R=301,L]
RewriteRule ^jasa/bore-pile-depok\.html$ /jasa/bore-pile/depok.html [R=301,L]
RewriteRule ^jasa/bore-pile-tangerang\.html$ /jasa/bore-pile/tangerang.html [R=301,L]
RewriteRule ^jasa/bore-pile-bandung\.html$ /jasa/bore-pile/bandung.html [R=301,L]
RewriteRule ^jasa/bore-pile-semarang\.html$ /jasa/bore-pile/semarang.html [R=301,L]
RewriteRule ^jasa/bore-pile-surabaya\.html$ /jasa/bore-pile/surabaya.html [R=301,L]
RewriteRule ^jasa/bore-pile-karawang\.html$ /jasa/bore-pile/karawang.html [R=301,L]
RewriteRule ^jasa/strauss-pile-jakarta\.html$ /jasa/strauss-pile/jakarta.html [R=301,L]

# ============================================================
# GENERIC RULE: Kalau ada request ke folder (berakhiran /)
# dan file .html-nya ada, redirect ke .html
# Ini menangkap SEMUA kasus tanpa perlu tulis satu-satu
# ============================================================

# 1. Halaman root: /jasa/ -> /jasa.html, /alat/ -> /alat.html, dll
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^([^/]+)/?$ /$1.html [R=301,L]

# 2. Subfolder level 1: /jasa/bore-pile/ -> /jasa/bore-pile.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/$2.html -f
RewriteRule ^([^/]+)/([^/]+)/?$ /$1/$2.html [R=301,L]

# 3. Subfolder level 2: /jasa/bore-pile/jakarta/ -> /jasa/bore-pile/jakarta.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/$2/$3.html -f
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/?$ /$1/$2/$3.html [R=301,L]

# 4. Subfolder level 3: /harga/bore-pile/30cm/ -> /harga/bore-pile/30cm.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1/$2/$3/$4.html -f
RewriteRule ^([^/]+)/([^/]+)/([^/]+)/([^/]+)/?$ /$1/$2/$3/$4.html [R=301,L]

# 5. index.html di subfolder: /jasa/bore-pile/jakarta/index.html -> /jasa/bore-pile/jakarta.html
RewriteRule ^(.+)/index\.html$ /$1.html [R=301,L]

# 6. /index.html -> / (beranda)
RewriteRule ^index\.html$ / [R=301,L]

# ============================================================
# KHUSUS: Galeri redirect (URL lama /galeri/ -> /galeri/gallery.html)
# ============================================================
RewriteRule ^galeri/?$ /galeri/gallery.html [R=301,L]

# ============================================================
# EXTENSIONLESS URLs: Bisa akses tanpa .html
# Contoh: /jasa/bore-pile/jakarta tetap bisa dibuka
# ============================================================
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# ============================================================
# PERFORMA & CACHING
# ============================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
