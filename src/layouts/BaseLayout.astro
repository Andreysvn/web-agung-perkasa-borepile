---
// src/layouts/BaseLayout.astro
import config from '../data/config.json';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import WhatsAppFloat from '../components/global/WhatsAppFloat.astro';
import ScrollTop from '../components/global/ScrollTop.astro';

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  ogType?: string;
}

const { 
  title, 
  description = config.meta.description, 
  keywords = config.meta.keywords,
  image = config.meta.ogImage,
  ogType = 'website'
} = Astro.props;

const siteTitle = `${title} | ${config.siteName}`;
---

<!DOCTYPE html>
<html lang="id">
<head>
    <!-- ===== META DASAR ===== -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="theme-color" content="#1a3a6e" />
    
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={config.siteName} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="QjaIirR3-qW7bARIyez5S0_WPeMjPJSqn6tnK44ZYMo" />
    
    <!-- ===== GEO TAGS ===== -->
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />
    
    <!-- ===== CANONICAL URL ===== -->
    <link rel="canonical" href={Astro.url.href} />
    
    <!-- ===== FAVICON ===== -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- ===== OPEN GRAPH ===== -->
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={config.siteName} />
    
    <!-- ===== TWITTER CARD ===== -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    
    <!-- ===== PRECONNECT & DNS PREFETCH ===== -->
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    
    <!-- ===== FONT AWESOME (Non-blocking) ===== -->
    <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" /></noscript>
    
    <!-- ===== AREFHS ANALYTICS ===== -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="F3ndI7tGSH1XWvznEXqZgQ" defer></script>
    
    <!-- ===== GLOBAL CSS ===== -->
    <link rel="stylesheet" href="/css/style.css" />
    
    <!-- ===== SCHEMA ORGANIZATION ===== -->
    <script type="application/ld+json" set:html>
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "@id": "https://agungperkasaborepile.com/#organization",
        "name": "${config.siteName}",
        "alternateName": "Agung Perkasa Bore Pile",
        "url": "${config.siteUrl}/",
        "logo": {
          "@type": "ImageObject",
          "url": "${config.siteUrl}/imgs/logo-agung-perkasa-transparan.png"
        },
        "description": "${config.company.description}",
        "telephone": "${config.company.phone}",
        "email": "${config.company.email}",
        "sameAs": [
          "${config.company.social.facebook}",
          "${config.company.social.instagram}"
        ]
      }
    </script>
    
    <!-- ===== SCHEMA WEBSITE ===== -->
    <script type="application/ld+json" set:html>
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "${config.siteUrl}/#website",
        "name": "${config.siteName}",
        "url": "${config.siteUrl}/",
        "description": "${config.company.description}",
        "publisher": {
          "@id": "${config.siteUrl}/#organization"
        },
        "inLanguage": "id-ID"
      }
    </script>
    
    <!-- ===== SCHEMA LOCAL BUSINESS ===== -->
    <script type="application/ld+json" set:html>
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "${config.siteUrl}/#localbusiness",
        "name": "${config.siteName}",
        "url": "${config.siteUrl}/",
        "parentOrganization": {
          "@id": "${config.siteUrl}/#organization"
        },
        "image": "${config.siteUrl}/imgs/logo-agung-perkasa-transparan.png",
        "description": "${config.company.description}",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Jl. Sunter Muara II, RT.17/RW.05, Sunter Agung",
          "addressLocality": "Jakarta Utara",
          "addressRegion": "DKI Jakarta",
          "postalCode": "14350",
          "addressCountry": "ID"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -6.1493743,
          "longitude": 106.8534975
        },
        "telephone": "${config.company.phone}",
        "priceRange": "Rp70.000 - Rp350.000",
        "openingHours": ["Mo-Su 07:00-23:00"],
        "sameAs": [
          "${config.company.social.facebook}",
          "${config.company.social.instagram}"
        ]
      }
    </script>
    
    <!-- ===== GOOGLE TAG MANAGER ===== -->
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-P6GBTKJB');
    </script>
    
    <!-- ===== GOOGLE ADS ===== -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-16649506462"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-16649506462');
    </script>
    
</head>
<body>
    
    <!-- ===== GTM NOSCRIPT ===== -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P6GBTKJB" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    
    <!-- ===== SKIP LINK ===== -->
    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>
    
    <!-- ===== NAVBAR ===== -->
    <Navbar />
    
    <!-- ===== MAIN CONTENT ===== -->
    <main id="main-content">
        <slot />
    </main>
    
    <!-- ===== FOOTER ===== -->
    <Footer />
    
    <!-- ===== WHATSAPP FLOAT ===== -->
    <WhatsAppFloat />
    
    <!-- ===== SCROLL TOP ===== -->
    <ScrollTop />
    
    <!-- ===== GLOBAL JS ===== -->
    <script src="/js/script.js" defer></script>
    
</body>
</html>