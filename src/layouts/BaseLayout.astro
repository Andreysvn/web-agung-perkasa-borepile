---
// src/layouts/BaseLayout.astro
import config from '../data/config.json';
import {
  organizationSchema as organizationSchemaBase,
  websiteSchema as websiteSchemaBase,
  localBusinessSchema as localBusinessSchemaBase,
  schemaPhone
} from '../lib/schema.js';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import WhatsAppFloat from '../components/global/WhatsAppFloat.astro';
import ScrollTop from '../components/global/ScrollTop.astro';
import ApxStyles from '../components/global/v2/ApxStyles.astro';
import NavbarV2 from '../components/global/v2/Navbar.astro';
import FooterV2 from '../components/global/v2/Footer.astro';
import WhatsAppFloatV2 from '../components/global/v2/WhatsAppFloat.astro';
import ScrollTopV2 from '../components/global/v2/ScrollTop.astro';

export interface Props {
  title: string;
  titleOverride?: string;
  ogTitle?: string;
  twTitle?: string;
  description?: string;
  keywords?: string;
  image?: string;
  ogType?: string;
  bodyClass?: string;
  design?: 'legacy' | 'v2';
  localBusinessOverride?: object;
  organizationOverride?: object;
  includeWebsiteSchema?: boolean;
}

const { 
  title, 
  titleOverride,
  ogTitle,
  twTitle,
  description = config.meta.description, 
  keywords = config.meta.keywords,
  image = config.meta.ogImage,
  ogType = 'website',
  bodyClass = '',
  design = 'legacy',
  localBusinessOverride,
  organizationOverride,
  includeWebsiteSchema = true
} = Astro.props;

const isV2 = design === 'v2';

const siteTitle = titleOverride ?? `${title} | ${config.siteName}`;
const headOgTitle = ogTitle ?? siteTitle;
const headTwTitle = twTitle ?? siteTitle;

const siteUrl = Astro.site ?? new URL(config.siteUrl);
const canonicalUrl = new URL(Astro.url.pathname.replace(/index\.html$/, ''), siteUrl).href;

const organizationSchema = organizationSchemaBase(
  organizationOverride !== undefined ? organizationOverride : {
    "alternateName": "Agung Perkasa Bore Pile",
    "logo": {
      "@type": "ImageObject",
      "url": `${config.siteUrl}/imgs/logo-agung-perkasa-transparan.png`
    },
    "description": config.company.description,
    "telephone": schemaPhone,
    "email": config.company.email
  }
);

const websiteSchema = websiteSchemaBase({
  "description": config.company.description,
  "inLanguage": "id-ID"
});

const localBusinessSchema = localBusinessSchemaBase(localBusinessOverride ?? {
  "description": config.company.description,
  "priceRange": "Rp70.000 - Rp350.000",
  "sameAs": [
    config.company.social.facebook,
    config.company.social.instagram
  ]
});
---

<!DOCTYPE html>
<html lang="id">
<head>
    <!-- ===== META DASAR ===== -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes" />
    <meta name="theme-color" content="#1a3a6e" />
    
    <title>{siteTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="author" content={config.siteName} />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="QjaIirR3-qW7bARIyez5S0_WPeMjPJSqn6tnK44ZYMo" />
    
    <!-- ===== GEO TAGS ===== -->
    <meta name="geo.region" content="ID" />
    <meta name="geo.placename" content="Indonesia" />
    
    <!-- ===== CANONICAL URL ===== -->
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- ===== FAVICON ===== -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- ===== OPEN GRAPH ===== -->
    <meta property="og:title" content={headOgTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={config.siteName} />
    
    <!-- ===== TWITTER CARD ===== -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={headTwTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    
    <!-- ===== PRECONNECT & DNS PREFETCH ===== -->
    {!isV2 && (
      <>
        <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
        <link rel="preconnect" href="https://unpkg.com" crossorigin />
      </>
    )}
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    
    <!-- ===== FONT AWESOME (Non-blocking) ===== -->
    {!isV2 && (
      <>
        <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" as="style" onload="this.onload=null;this.rel='stylesheet'" />
        <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" /></noscript>
      </>
    )}
    
    <!-- ===== AREFHS ANALYTICS ===== -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="F3ndI7tGSH1XWvznEXqZgQ" defer></script>
    
    <!-- ===== GLOBAL CSS ===== -->
    {!isV2 && <link rel="stylesheet" href="/css/style.css" />}
    {isV2 && (
      <>
        <link rel="preload" href="/fonts/plus-jakarta-sans-latin-var.woff2" as="font" type="font/woff2" crossorigin />
        <ApxStyles />
      </>
    )}
    
    <!-- ===== SCHEMA ORGANIZATION ===== -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    
    <!-- ===== SCHEMA WEBSITE ===== -->
    {includeWebsiteSchema && <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />}
    
    <!-- ===== SCHEMA LOCAL BUSINESS ===== -->
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    
    <!-- ===== GOOGLE TAG MANAGER ===== -->
    <script>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-P6GBTKJB');
    </script>
    
    <!-- ===== GOOGLE ADS ===== -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-16649506462"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-16649506462');
    </script>
    
</head>
<body class={bodyClass}>
    
    <!-- ===== GTM NOSCRIPT ===== -->
    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P6GBTKJB" height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>
    
    <!-- ===== SKIP LINK ===== -->
    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>
    
    <!-- ===== NAVBAR ===== -->
    {isV2 ? <NavbarV2 /> : <Navbar />}
    
    <!-- ===== MAIN CONTENT ===== -->
    <main id="main-content">
        <slot />
    </main>
    
    <!-- ===== FOOTER ===== -->
    {isV2 ? <FooterV2 /> : <Footer />}
    
    <!-- ===== WHATSAPP FLOAT ===== -->
    {isV2 ? <WhatsAppFloatV2 /> : <WhatsAppFloat />}
    
    <!-- ===== SCROLL TOP ===== -->
    {isV2 ? <ScrollTopV2 /> : <ScrollTop />}
    
    <!-- ===== GLOBAL JS ===== -->
    {!isV2 && <script src="/js/script.js" defer></script>}
    
</body>
</html>