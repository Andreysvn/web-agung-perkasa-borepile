---
import config from '../data/config.json';
import FaIcon from '../components/icons/FaIcon.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import GoogleMapsEmbed from '../components/shared/GoogleMapsEmbed.astro';
import PublisherBox from '../components/shared/PublisherBox.astro';
import { organizationSchema, localBusinessSchema } from '../lib/schema.js';

export interface Props {
    // SEO & Head
    title: string;
    description: string;
    canonical: string;
    ogTitle?: string;
    ogDescription?: string;
    ogImage?: string;
    twitterTitle?: string;
    twitterDescription?: string;

    // City data
    cityName: string;
    citySlug: string;
    geoRegion?: string;
    geoPlacename?: string;

    // Schema
    localBusinessDesc?: string;
    areaServed?: Array<{ "@type": string; name: string }>;
    breadcrumbItems?: Array<{ name: string; url: string }>;
    faqSchema?: Array<{ q?: string; a?: string; question?: string; answer?: string }>;
    serviceSchema?: string;
    productSchema?: string;

    // Google Ads
    hasGoogleAds?: boolean;
    googleAdsId?: string;

    // Maps
    mapsNote?: string;

    // Publisher
    publisherDesc?: string;

    // CTA
    ctaTitle?: string;
    ctaText?: string;

    // Extra CSS
    extraCss?: string[];
}

const {
    title,
    description,
    canonical,
    ogTitle,
    ogDescription,
    ogImage,
    twitterTitle,
    twitterDescription,
    cityName,
    citySlug,
    geoRegion = 'ID',
    geoPlacename = '',
    localBusinessDesc = '',
    areaServed = [{ "@type": "City", "name": cityName }],
    breadcrumbItems = [],
    faqSchema = [],
    serviceSchema,
    productSchema,
    hasGoogleAds = false,
    googleAdsId = '',
    mapsNote,
    publisherDesc,
    ctaTitle,
    ctaText,
    extraCss = [],
} = Astro.props;

// Default og:image — use city hero image if provided, else generic logo
const defaultOgImage = `https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp`;
const finalOgImage = ogImage ? `https://agungperkasaborepile.com${ogImage}` : defaultOgImage;

// Schema JSON-LD
const orgLd = JSON.stringify(organizationSchema());
const localBusinessLd = JSON.stringify(localBusinessSchema({
    description: localBusinessDesc,
    areaServed: areaServed,
}));

// Breadcrumb Schema
const breadcrumbLd = breadcrumbItems.length > 0 ? JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": breadcrumbItems.map((item, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": item.name,
        "item": item.url,
    })),
}) : null;

// FAQ Schema
const faqLd = faqSchema.length > 0 ? JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqSchema.map((item) => ({
        "@type": "Question",
        "name": item.question || item.q,
        "acceptedAnswer": {
            "@type": "Answer",
            "text": item.answer || item.a,
        },
    })),
}) : null;

// CTA defaults
const finalCtaTitle = ctaTitle || (cityName ? `Butuh jasa bore pile di ${cityName}?` : `Butuh jasa bore pile profesional?`);
const finalCtaText = ctaText || 'Dapatkan penawaran harga dari kami.';
const waLink = `https://wa.me/${config.company.whatsapp}?text=Halo%20Pak%2C%20Saya%20dari%20website%20ingin%20menanyakan%20terkait%20penawaran%20harga%20bore%20pile%20untuk%20proyek${cityName ? "%20di%20" + encodeURIComponent(cityName) : ""}.`;
---
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#1a365d">
    <title>{title}</title>

    <meta name="description" content={description}>
    <meta name="robots" content="index, follow">
    <meta name="google-site-verification" content="QjaIirR3-qW7bARIyez5S0_WPeMjPJSqn6tnK44ZYMo">

    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={ogTitle || title}>
    <meta property="og:description" content={ogDescription || description}>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="id_ID">
    <meta property="og:url" content={canonical}>
    <meta property="og:image" content={finalOgImage}>
    <meta property="og:site_name" content={config.siteName}>

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={twitterTitle || ogTitle || title}>
    <meta name="twitter:description" content={twitterDescription || ogDescription || description}>
    <meta name="twitter:image" content={finalOgImage}>

    <!-- Geo Tags -->
    {geoRegion && <meta name="geo.region" content={geoRegion} />}
    {geoPlacename && <meta name="geo.placename" content={geoPlacename} />}

    <!-- Preconnect -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">

    <!-- Ahrefs Analytics -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="F3ndI7tGSH1XWvznEXqZgQ" defer></script>

    <!-- CSS (critical render-blocking) -->
    <link rel="stylesheet" href="/css/borepile-kota.css?v=3">
    <!-- CSS (non-critical — loaded after render) -->
    <link rel="stylesheet" href="/css/lightbox.css" media="print" onload="this.media='all'">
    {extraCss.map((css) => <link rel="stylesheet" href={css} />)}

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={orgLd}></script>
    <script type="application/ld+json" set:html={localBusinessLd}></script>
    {breadcrumbLd && <script type="application/ld+json" set:html={breadcrumbLd}></script>}
    {faqLd && <script type="application/ld+json" set:html={faqLd}></script>}
    {serviceSchema && <script type="application/ld+json" set:html={serviceSchema}></script>}
    {productSchema && <script type="application/ld+json" set:html={productSchema}></script>}
</head>
<body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P6GBTKJB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <!-- Google Tag Manager (Deferred load) -->
    <script is:inline>window.addEventListener('load',function(){
let gtmLoaded = false;
function loadGTM() {
  if (gtmLoaded) return;
  gtmLoaded = true;
  (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":
  new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src=
  "https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,"script","dataLayer","GTM-P6GBTKJB");
}
window.addEventListener("scroll", loadGTM, {once: true});
window.addEventListener("mousemove", loadGTM, {once: true});
window.addEventListener("touchstart", loadGTM, {once: true});
setTimeout(loadGTM, 3500);
});</script>
    <!-- End Google Tag Manager -->

    {hasGoogleAds && (
        <Fragment>
            <script is:inline type="text/javascript" define:vars={{googleAdsId}}>let gtagLoaded = false; function loadGtag() { if (gtagLoaded) return; gtagLoaded = true; let script = document.createElement("script"); script.src = "https://www.googletagmanager.com/gtag/js?id=" + googleAdsId; script.async = true; document.head.appendChild(script); } window.addEventListener("scroll", loadGtag, {once: true}); window.addEventListener("mousemove", loadGtag, {once: true}); window.addEventListener("touchstart", loadGtag, {once: true}); setTimeout(loadGtag, 3500); </script>
            <script is:inline define:vars={{ googleAdsId }}>
                window.addEventListener('load', function() {
                    window.dataLayer = window.dataLayer || [];
                    function gtag(){dataLayer.push(arguments);}
                    gtag('js', new Date());
                    gtag('config', googleAdsId);
                });
            </script>
        </Fragment>
    )}

    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>

    <Navbar />

    <!-- ===== MAIN CONTENT ===== -->
    <main id="main-content">
        <div class="blog-container">
            <slot />
        </div>
    </main>

    <!-- ===== CTA, MAPS, PUBLISHER (WRAPPED IN CONTAINER) ===== -->
    <div class="container">
        <!-- ===== CTA BOX ===== -->
        <div class="cta-box">
            <h3>{finalCtaTitle}</h3>
            <p>{finalCtaText}</p>
            <a href={waLink} class="btn-wa-konsultasi" target="_blank" rel="noopener noreferrer" aria-label="Konsultasi gratis via WhatsApp">Konsultasi Gratis via WA</a>
        </div>

        <!-- ===== GOOGLE MAPS ===== -->
        <GoogleMapsEmbed cityName={cityName} mapsNote={mapsNote} />

        <!-- ===== PUBLISHER BOX ===== -->
        <PublisherBox description={publisherDesc} />
    </div>

    <Footer />

    <!-- ===== WHATSAPP FLOAT ===== -->
    <a href={waLink} class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Chat konsultasi melalui WhatsApp">
        <FaIcon class="fab fa-whatsapp" />
    </a>

    <button class="scroll-top" id="scrollTop" aria-label="Kembali ke atas">
        <FaIcon class="fas fa-arrow-up" />
    </button>

    <!-- ===== JS (defer — not render-blocking) ===== -->
    <script src="/js/jasa.js" defer></script>
    <script src="/js/harga-calculator.js" defer></script>
    <script src="/js/lightbox.js" defer></script>
</body>
</html>


