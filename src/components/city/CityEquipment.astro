---
import config from '../../data/config.json';

interface Props {
    equipment: {
        description?: string;
        items: Array<{
            name: string;
            desc?: string;
            description?: string;
            image?: string;
            imageAlt?: string;
        }>;
    };
    cityName: string;
}

const { equipment, cityName } = Astro.props;
---

<h3 class="equip-title">Alat yang Kami gunakan di lapangan</h3>
<p class="equip-sub">{equipment.description || `Kami memiliki beberapa alat untuk pekerjaan bore pile, antara lain:`}</p>

<div class="equip-grid">
    {equipment.items.map((item) => (
        <div class="equip-item">
            {item.image ? (
                <img class="equip-img" src={item.image} alt={item.imageAlt || item.name} width="120" height="120" loading="lazy" />
            ) : (
                <img class="equip-img" src="/imgs/logo-agung-perkasa.webp" alt={`Ikon ${item.name}`} width="80" height="80" loading="lazy" />
            )}
            <div class="equip-info">
                <div class="equip-icon-inline">
                    <img src="/imgs/logo-agung-perkasa.webp" alt={`Ikon ${item.name}`} width="24" height="24" />
                    <h4>{item.name}</h4>
                </div>
                <p>{item.desc || item.description || ''}</p>
                <span class="equip-tag">{config.siteName.split(' ')[0]}</span>
            </div>
        </div>
    ))}
</div>
