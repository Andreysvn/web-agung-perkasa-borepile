---
interface Props {
    whyUs: Array<{ title: string; description?: string; desc?: string }>;
    cityName: string;
}

const { whyUs, cityName } = Astro.props;
---

<section class="why-section">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">Kenapa pilih Agung Perkasa untuk Bore Pile di {cityName}?</h2>
            <p class="section-subtitle">Ini alasan kenapa banyak orang {cityName} percaya sama Agung Perkasa.</p>
        </div>

        <div class="reasons-grid">
            {whyUs.map((item) => (
                <div class="reason-card">
                    <h3>{item.title}</h3>
                    <p>{item.description || item.desc || ''}</p>
                </div>
            ))}
        </div>
    </div>
</section>
