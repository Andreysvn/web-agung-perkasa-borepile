---
interface Props {
    title?: string;
    description?: string;
}

const { 
    title = "Komitmen & Garansi Mutu",
    description = "Kami memberikan garansi penuh atas kualitas dalam pengerjaan proyek. Kami menjamin kualitas terbaik karena didukung oleh tim ahli kami yang sangat berpengalaman membuat pondasi dalam (khususnya bore pile)."
} = Astro.props;
---

<div class="commitment-box">
    <div class="icon" aria-hidden="true">🛡️</div>
    <p><strong>{title}</strong><br>{description}</p>
</div>
