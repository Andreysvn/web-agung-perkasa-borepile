---
import { formatPrices } from '../../utils/priceFormatter.js';

interface Props {
    projects: Array<{
        hasImage?: boolean;
        image?: string;
        imageAlt?: string;
        imageCaption?: string;
        title: string;
        specs: string;
        method?: string;
        costLines?: string[];
        costCalc?: string;
        mobilization?: string;
        total: string;
        time: string;
    }>;
    cityName: string;
    note?: string;
}

const { projects, cityName, note } = Astro.props;
---

<section class="project-examples-section">
    <h2 class="project-heading">Contoh Hitungan Proyek Nyata{cityName ? ` di ${cityName}` : ''}</h2>
    {projects.map((project) => (
        <div class="project-card">
            <div class="project-row">
                {project.hasImage && project.image && (
                    <div class="project-img">
                        <div class="project-img-wrapper"><img src={project.image} alt={formatPrices(project.imageAlt) || ''} loading="lazy" width="400" height="300" data-lightbox="true" style="cursor: pointer;" title="Klik untuk memperbesar"></div>
                        {project.imageCaption && (
                            <div class="project-caption">{formatPrices(project.imageCaption)}</div>
                        )}
                    </div>
                )}
                <div class="project-text">
                    <div class="info-card">
                        <h3>{formatPrices(project.title)}</h3>
                        <p set:html={formatPrices(project.specs)}></p>
                        {project.method && <p><strong>Metode:</strong> {formatPrices(project.method)}</p>}
                        <p>
                            {project.costLines ? project.costLines.map((line) => (
                                <Fragment set:html={formatPrices(line) + '<br>'}></Fragment>
                            )) : project.costCalc ? (
                                <Fragment set:html={formatPrices(project.costCalc) + '<br>'}></Fragment>
                            ) : null}
                            {project.mobilization && (
                                <Fragment set:html={`<strong>+ mobilisasi:</strong> ${formatPrices(project.mobilization)}<br>`}></Fragment>
                            )}
                            <strong>Total:</strong> <strong class="price-total">{formatPrices(project.total)}</strong><br>
                            <strong>Waktu:</strong> {formatPrices(project.time)}
                        </p>
                    </div>
                </div>
            </div>
        </div>
    ))}

    {note && (
        <div class="project-note">
            <p set:html={formatPrices(note)}></p>
        </div>
    )}
</section>


