---
import { formatPrices } from '../../utils/priceFormatter.js';

interface Props {
    data: {
        heroImage: string;
        heroAlt: string;
        heroCaption: string;
        heroWidth?: string;
        heroHeight?: string;
        heroText: string;
        name: string;
    };
}

const { data } = Astro.props;
const { heroImage, heroAlt, heroCaption, heroWidth = '372', heroHeight = '350', heroText, name: cityName } = data;
---

<div class="illustration">
    <div class="illustration-img">
        <img src={heroImage} alt={formatPrices(heroAlt)} title={`Bore Pile Mini Crane ${cityName}`} width={heroWidth} height={heroHeight} fetchpriority="high">
        <div class="caption">{formatPrices(heroCaption)}</div>
    </div>
    <div class="illustration-text">
        <p set:html={formatPrices(heroText)}></p>
    </div>
</div>
