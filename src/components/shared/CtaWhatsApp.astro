---
import config from '../../data/config.json';
import FaIcon from '../icons/FaIcon.astro';

interface Props {
    cityName: string;
}

const { cityName } = Astro.props;

const waMessage = encodeURIComponent(Halo Pak, Saya dari website ingin menanyakan terkait penawaran harga bore pile untuk proyek .);
const waUrl = https://wa.me/?text=;
---

<div class="cta-box">
    <h3>Butuh jasa bore pile di {cityName}?</h3>
    <p>Dapatkan penawaran harga dan konsultasi gratis langsung dari tim teknis kami.</p>
    <a href={waUrl} class="btn-wa-konsultasi" aria-label="Konsultasi gratis via WhatsApp">
        <FaIcon class="fab fa-whatsapp" style="font-size: 1.25rem;" />
        Konsultasi Gratis via WA
    </a>
</div>
