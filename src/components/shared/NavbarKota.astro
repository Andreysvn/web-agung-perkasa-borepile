---
import FaIcon from '../icons/FaIcon.astro';

interface Props {
    citySlug?: string;
    cityName?: string;
    variant?: 'kota' | 'harga';
}

const { citySlug = '', cityName = '', variant = 'kota' } = Astro.props;

const isActive = (path: string) => {
    if (variant === 'kota' && citySlug) {
        return path.includes(citySlug) ? 'active' : '';
    }
    return '';
};

const isHargaActive = (path: string) => {
    return Astro.url.pathname.includes(path) ? 'active' : '';
};
---

<nav class="navbar" aria-label="Navigasi utama">
    <div class="container">
        <a href="/" class="logo" aria-label="Agung Perkasa Borepile - Beranda">
            <img src="/imgs/logo-agung-perkasa-transparan.webp" alt="Logo Agung Perkasa Borepile" width="45" height="45">
            <span>Agung Perkasa <br>Borepile</span>
        </a>
        <button class="menu-toggle" id="mobile-menu" aria-label="Menu navigasi" aria-expanded="false">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </button>
        <ul class="nav-menu" role="list">
            <li role="listitem"><a href="/">Beranda</a></li>
            <li class="dropdown" role="listitem">
                <span class="dropbtn">Layanan<FaIcon class="fas fa-chevron-down" /></span>
                <ul class="dropdown-content">
                    <li><a href="/jasa/">Jasa</a></li>
                    <li><a href="/jasa/bore-pile/jakarta.html" class={isActive('jakarta')}>Bore Pile Mesin</a></li>
                    <li><a href="/jasa/strauss-pile/jakarta.html">Strauss Pile</a></li>
                </ul>
            </li>
            <li class="dropdown" role="listitem">
                <span class="dropbtn">Harga<FaIcon class="fas fa-chevron-down" /></span>
                <ul class="dropdown-content">
                    <li><a href="/harga/bore-pile-2026.html" class={isHargaActive('bore-pile-2026')}>Bore Pile 2026</a></li>
                    <li><a href="/harga/bore-pile/30cm.html">Semua Harga</a></li>
                </ul>
            </li>
            <li role="listitem"><a href="/galeri/gallery.html" class="btn-nav">Galeri</a></li>
            <li role="listitem"><a href="/artikel.html">Artikel</a></li>
            <li role="listitem"><a href="/#contact">Hubungi</a></li>
        </ul>
    </div>
</nav>
