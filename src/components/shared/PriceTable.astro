---
import pricing from '../../data/harga.json';

interface Props {
    cityName: string;
    highlightDiameter?: number;
}

const { cityName, highlightDiameter } = Astro.props;

const currentYear = new Date().getFullYear();

const formatPrice = (price: number) => {
    return price > 0 ? price.toLocaleString('id-ID') : 'Hubungi Kami';
};

const isHighlighted = (d: number) => d === highlightDiameter;
---

<section aria-labelledby="table-heading">
    <h2 id="table-heading" class="section-heading">Tabel Harga Bore Pile {cityName} {currentYear} (Jasa Bor Saja)</h2>
    <p>Berikut <strong>harga JASA PENGEBORAN SAJA</strong> (belum termasuk material beton & besi) untuk wilayah {cityName} dan sekitarnya. Kedalaman pengeboran bergantung pada diameter dan kondisi lapisan tanah, pastikan cek sondir tanah dahulu agar mengetahui kedalaman yang tepat untuk pengeboran hingga mencapai tanah keras.</p>

    <h3>Bore Pile Mesin (Mini Crane & Gawangan)</h3>
    <div class="table-responsive">
        <table class="price-table">
            <caption>Tabel harga bore pile mesin (mini crane & gawangan) per meter</caption>
            <thead>
                <tr><th>Diameter</th><th>Harga (Rp/m)</th><th>Kedalaman Maks</th><th>Cocok Untuk</th></tr>
            </thead>
            <tbody>
                {pricing.mesin.map((item) => (
                    <tr class={isHighlighted(item.diameter) ? 'row-highlight' : ''}>
                        <td>{item.diameter} cm</td>
                        <td><strong>{formatPrice(item.price)}</strong></td>
                        <td>{item.maxDepth} meter</td>
                        <td>{item.suitable}</td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>

    <h3>Strauss Pile (Bore Pile Manual)</h3>
    <div class="table-responsive">
        <table class="price-table">
            <caption>Tabel harga Strauss Pile (bore pile manual) per meter</caption>
            <thead>
                <tr><th>Diameter</th><th>Harga (Rp/m)</th><th>Kedalaman Maks</th><th>Cocok Untuk</th></tr>
            </thead>
            <tbody>
                {pricing.manual.map((item) => (
                    <tr class={isHighlighted(item.diameter) ? 'row-highlight' : ''}>
                        <td>{item.diameter} cm</td>
                        <td><strong>{formatPrice(item.price)}</strong></td>
                        <td>{item.maxDepth} meter</td>
                        <td>{item.suitable}</td>
                    </tr>
                ))}
            </tbody>
        </table>
    </div>
</section>
