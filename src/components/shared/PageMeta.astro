---
interface Props {
    title: string;
    updateDate: string;
    author?: string;
    location: string;
}

const { 
    title, 
    updateDate, 
    author = "Agung Perkasa", 
    location 
} = Astro.props;
---

<h1 class="page-title">{title}</h1>

<div class="page-meta">
    <span>Update: {updateDate}</span> |
    <span>{author}</span> |
    <span>📍 {location}</span>
</div>

<div class="update-badge">
    Harga terbaru {updateDate} | Konsultasi gratis
</div>
