---
import config from '../../data/config.json';
import galeri from '../../data/galeri.json';
import { organizationSchema, localBusinessSchema, schemaPhone } from '../../lib/schema.js';

import FaIcon from '../../components/icons/FaIcon.astro';
import Navbar from '../../components/global/Navbar.astro';
import Footer from '../../components/global/Footer.astro';

const PER_PAGE = 20;
const totalPages = Math.ceil(galeri.length / PER_PAGE);
const pagePhotos = galeri.slice(0, PER_PAGE);

const orgLd = JSON.stringify(organizationSchema({
    "alternateName": "Agung Perkasa Bore Pile",
    "description": "Spesialis pondasi bore pile dan strauss pile melayani Jabodetabek dan seluruh Jawa.",
    "telephone": schemaPhone,
    "email": config.company.email,
    "logo": { "@type": "ImageObject", "url": `${config.siteUrl}/imgs/logo-agung-perkasa-transparan.png` }
}));

const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": "Galeri proyek bore pile dan strauss pile Agung Perkasa.",
    "priceRange": "Rp70.000 - Rp350.000",
    "openingHours": "Mo-Su 07:00-23:00"
}));
---
<!DOCTYPE html>
<html lang="id">
<head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-P6GBTKJB');</script>
    <!-- End Google Tag Manager -->
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#1a3a6e">
    
    <title>Galeri Proyek Bore Pile | Agung Perkasa</title>
    
    <meta name="description" content="Galeri foto proyek bore pile dan strauss pile dari Agung Perkasa. Lihat hasil pekerjaan pondasi kami di berbagai proyek JABODETABEK dan Pulau Jawa.">
    <meta name="author" content="Agung Perkasa Borepile">
    <meta name="robots" content="index, follow">
    <meta name="google-site-verification" content="QjaIirR3-qW7bARIyez5S0_WPeMjPJSqn6tnK44ZYMo">
    
    <link rel="canonical" href="https://agungperkasaborepile.com/galeri/gallery.html" />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="Galeri Proyek Bore Pile | Agung Perkasa">
    <meta property="og:description" content="Galeri foto proyek bore pile dan strauss pile dari Agung Perkasa.">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="id_ID">
    <meta property="og:url" content="https://agungperkasaborepile.com/galeri/gallery.html">
    <meta property="og:image" content="https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="Agung Perkasa Borepile">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Galeri Proyek Bore Pile | Agung Perkasa">
    <meta name="twitter:description" content="Portfolio proyek pondasi borepile Agung Perkasa">
    <meta name="twitter:image" content="https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp">
    
    <!-- Geo Tags -->
    <meta name="geo.region" content="ID">
    <meta name="geo.placename" content="Indonesia">
    
    <!-- Preconnect & DNS Prefetch -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <!-- Ahrefs Analytics -->
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="F3ndI7tGSH1XWvznEXqZgQ" defer></script>
    
    <!-- CSS EKSTERNAL -->
    <link rel="stylesheet" href="/css/gallery.css">
</head>
<body>
    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>
    
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P6GBTKJB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    
    <Navbar />

    <main id="main-content">
        <!-- Hero Section -->
        <div class="gallery-hero">
            <h1>Galeri Agung Perkasa</h1>
            <p>Beberapa dokumentasi pengerjaan pondasi bore pile & strauss pile oleh Agung Perkasa Bore Pile</p>
            <div class="gallery-stats">
                <div class="stat-item">
                    <div class="stat-number">10+</div>
                    <div class="stat-label">Tahun Pengalaman</div>
                </div>
            </div>
        </div>
        <p class="text-center" style="margin: 20px;"> 
            <a href="/jasa/bore-pile/jakarta.html">Lihat detail harga bore pile terbaru 2026 →</a>
        </p>

        <div class="container">
            <!-- Breadcrumb -->
            <nav class="breadcrumb" aria-label="Breadcrumb navigasi">
                <a href="/">Beranda</a>
                <span class="separator">/</span>
                
                <span class="current" aria-current="page">Galeri</span>
            </nav>
            
            <h2 style="color: var(--primary-color); text-align: center; margin: 20px 0 10px;">Portofolio Pekerjaan Kami</h2>
            <p style="text-align: center; color: #666; margin-bottom: 30px;">Berikut adalah beberapa proyek bore pile yang telah kami kerjakan</p>
            
            <!-- Filter -->
            <div class="gallery-filter">
                <button class="filter-chip active" data-filter="all">Semua</button>
                <button class="filter-chip" data-filter="borepile">Bore Pile Mesin</button>
                <button class="filter-chip" data-filter="strauss">Strauss Pile</button>
                <button class="filter-chip" data-filter="proses">Proses Pengerjaan</button>
            </div>
            
           <!-- Gallery Grid - Data-driven dari galeri.json -->
<div class="gallery-grid" id="galleryGrid">
    {pagePhotos.map((photo) => (
        <div class="gallery-card" data-category={photo.category}>
            <img src={photo.image}
                 alt={photo.label + ' - ' + photo.detail}
                 class="gallery-card-img"
                 loading="lazy"
                 onerror="this.src='/imgs/logo-agung-perkasa.webp'">
            <div class="gallery-card-caption">
                <span class="label">{photo.label}</span>
                <span class="detail">{photo.detail}</span>
            </div>
        </div>
    ))}
</div>

            {totalPages > 1 && (
                <nav class="gallery-pagination" aria-label="Navigasi galeri">
                    <div class="pagination-info">Halaman 1 dari {totalPages}</div>
                    <span class="pagination-current">1</span>
                    <a href="/galeri/gallery-2.html" class="pagination-link">2</a>
                    <a href="/galeri/gallery-2.html" class="pagination-next">
                        Selanjutnya
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" /></svg>
                    </a>
                </nav>
            )}
            
            <!-- CTA -->
            <div class="gallery-cta">
                <h3>Butuh jasa Bore Pile?</h3>
                <p>Hubungi tim kami untuk konsultasi gratis dan penawaran harga terbaik, dapatkan diskon spesial untuk klien baru.</p>
                <div style="margin-top: 20px;">
                    <a href={`https://wa.me/${config.company.whatsapp}?text=Halo%20Pak%2C%20Saya%20dari%20website%20ingin%20menanyakan%20terkait%20diskon%20untuk%20bore%20pile.`} class="btn-primary" target="_blank" style="margin-right: 10px;">
                        <FaIcon class="fab fa-whatsapp" /> Dapatkan Diskon Spesial
                    </a>
                    <a href="/#contact" class="btn-secondary">
                        <FaIcon class="fas fa-envelope" /> Kontak Kami
                    </a>
                </div>
            </div>
        </div>
    </main>

    <!-- ==================== SECTION ARTIKEL ==================== -->
    <section class="gallery-articles-section">
        <div class="container">
            <div class="section-header">
                <h2 class="section-title">Artikel Kami</h2>
                <p class="section-subtitle">Informasi penting seputar pondasi bore pile dan konstruksi</p>
            </div>
            
            <div class="articles-grid" id="articlesGrid">
                <!-- Artikel 1 -->
                <article class="article-card">
                    <a href="/artikel/bore-pile-vs-strauss-pile.html" class="article-link">
                        <div class="article-image">
                            <img src="/imgs/borepile-dekat-dinding.jpg" alt="Perbandingan Bore Pile vs Strauss Pile" loading="lazy">
                            <span class="article-category">Perbandingan</span>
                        </div>
                        <div class="article-content">
                            <h3>Bore Pile vs Strauss Pile: Mana yang Cocok untuk Proyek Anda?</h3>
                            <p class="article-excerpt">Perbandingan lengkap antara bore pile mesin dan strauss pile manual dari segi biaya, kedalaman, dan jenis proyek yang cocok.</p>
                            <div class="article-meta">
                                <span class="article-date"><FaIcon class="far fa-calendar-alt" /> Juni 2026</span>
                                <span class="article-read-more">Baca selengkapnya →</span>
                            </div>
                        </div>
                    </a>
                </article>
                
                <!-- Artikel 2 -->
                <article class="article-card">
                    <a href="/artikel/borepile-vs-tiang-pancang.html" class="article-link">
                        <div class="article-image">
                            <img src="/imgs/hasil-lubang-borepile.webp" alt="Bore Pile vs Tiang Pancang" loading="lazy">
                            <span class="article-category">Tips</span>
                        </div>
                        <div class="article-content">
                            <h3>Bore Pile vs Tiang Pancang: Mana Lebih Kuat & Ekonomis?</h3>
                            <p class="article-excerpt">Ketahui perbedaan mendasar antara bore pile dan tiang pancang, termasuk kelebihan, kekurangan, serta biaya yang perlu Anda persiapkan.</p>
                            <div class="article-meta">
                                <span class="article-date"><FaIcon class="far fa-calendar-alt" /> Mei 2026</span>
                                <span class="article-read-more">Baca selengkapnya →</span>
                            </div>
                        </div>
                    </a>
                </article>
                
                <!-- Artikel 3 -->
                <article class="article-card">
                    <a href="/harga/bore-pile/30cm.html" class="article-link">
                        <div class="article-image">
                            <img src="/imgs/borepile-jakarta-timur-14-mei-2026.webp" alt="Harga Bore Pile 2026" loading="lazy">
                            <span class="article-category">Harga</span>
                        </div>
                        <div class="article-content">
                            <h3>Harga Bore Pile Diameter 30cm</h3>
                            <p class="article-excerpt">Informasi harga bore pile per meter terbaru untuk diameter 30cm, lengkap dengan kalkulator estimasi biaya pengeboran.</p>
                            <div class="article-meta">
                                <span class="article-date"><FaIcon class="far fa-calendar-alt" /> Juni 2026</span>
                                <span class="article-read-more">Baca selengkapnya →</span>
                            </div>
                        </div>
                    </a>
                </article>
            </div>
            
            <div class="articles-cta">
                <a href="/artikel/" class="btn-articles-all">
                    <FaIcon class="fas fa-newspaper" /> Lihat Semua Artikel
                </a>
            </div>
        </div>
    </section>
    
    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
        <div class="lightbox-content">
            <button class="close-lightbox" aria-label="Tutup">&times;</button>
            <button class="nav-lightbox prev" aria-label="Sebelumnya">&#10094;</button>
            <img class="lightbox-img" id="lightboxImg" src="" alt="">
            <button class="nav-lightbox next" aria-label="Selanjutnya">&#10095;</button>
            <div class="lightbox-caption" id="lightboxCaption"></div>
        </div>
    </div>
    
    <Footer />
    
    <!-- TOMBOL WHATSAPP -->
    <a href={`https://wa.me/${config.company.whatsapp}?text=Halo%20Pak%2C%20Saya%20dari%20website%20ingin%20menanyakan%20terkait%20penawaran%20harga%20bore%20pile.`} 
       class="whatsapp-float" 
       target="_blank" 
       rel="noopener noreferrer" 
       aria-label="Chat konsultasi melalui WhatsApp">
       <FaIcon class="fab fa-whatsapp" />
    </a>
    <button class="scroll-top" id="scrollTop" aria-label="Kembali ke atas">
        <FaIcon class="fas fa-arrow-up" />
    </button>
    
    <!-- JS EKSTERNAL -->
    <script is:inline src="/js/gallery.js" defer></script>
    
    <!-- Schema Markup -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "ImageGallery",
        "name": "Galeri Proyek Bore Pile Agung Perkasa",
        "description": "Dokumentasi proyek bore pile dan strauss pile",
        "url": "https://agungperkasaborepile.com/galeri/gallery.html"
    }
    </script>
    
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Beranda",
                "item": "https://agungperkasaborepile.com/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Galeri",
                "item": "https://agungperkasaborepile.com/galeri/gallery.html"
            }
        ]
    }
    </script>

    <!-- ===== SCHEMA ORGANIZATION ===== -->
<script type="application/ld+json" set:html={orgLd} />

<!-- ===== SCHEMA LOCAL BUSINESS ===== -->
<script type="application/ld+json" set:html={localBusinessLd} />
</body>
</html>