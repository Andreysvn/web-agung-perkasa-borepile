---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import config from '../../../../data/config.json';
import pricing from '../../../../data/harga.json';
import { organizationSchema, localBusinessSchema } from '../../../../lib/schema.js';

import FaIcon from '../../../../components/icons/FaIcon.astro';
import CityGuarantee from '../../../../components/city/CityGuarantee.astro';

const manualPrice = pricing.manual.find(item => item.price > 0)?.price || 75000;
const mesinPrice = pricing.mesin.find(item => item.price > 0)?.price || 120000;
const manualPriceStr = manualPrice.toLocaleString('id-ID');
const mesinPriceStr = mesinPrice.toLocaleString('id-ID');

const orgLd = JSON.stringify(organizationSchema());

const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": `Jasa Strauss Pile (bore pile manual) Jakarta. Harga mulai Rp${manualPriceStr}/m. Solusi lahan sempit & padat penduduk. Melayani seluruh Jakarta.`,
    "priceRange": `Rp${manualPriceStr} - Rp${mesinPriceStr}`,
    "areaServed": [
            { "@type": "City", "name": "Jakarta" }
        ]
}));
---

<BaseLayout title={`Jasa & Harga Strauss Pile Jakarta 2026 (Manual) | Mulai Rp${manualPriceStr}`}
    description={`Jasa Strauss Pile (bore pile manual) Jakarta 2026. Harga mulai Rp${manualPriceStr}/m. Solusi pondasi untuk lahan sempit & gang padat. Konsultasi gratis. Melayani seluruh Jakarta.`}
    bodyClass="services">
    <Fragment slot="head">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta property="og:title" content={`Jasa & Harga Strauss Pile Jakarta 2026 | Mulai Rp${manualPriceStr}`}>
        <meta property="og:description" content={`Jasa Strauss Pile Jakarta. Harga mulai Rp${manualPriceStr}/m. Solusi pondasi gang sempit.`}>
        <meta property="og:type" content="website">
        <meta property="og:locale" content="id_ID">
        <meta property="og:url" content="https://agungperkasaborepile.com/jasa/strauss-pile/jakarta/">
        <meta property="og:image" content="https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp">
        <meta property="og:site_name" content="Agung Perkasa Borepile">
        
