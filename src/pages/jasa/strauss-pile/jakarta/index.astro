---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import config from '../../../../data/config.json';
import pricing from '../../../../data/harga.json';
import { organizationSchema, localBusinessSchema } from '../../../../lib/schema.js';

import FaIcon from '../../../../components/icons/FaIcon.astro';
import CityGuarantee from '../../../../components/city/CityGuarantee.astro';

const manualPrice = pricing.manual.find(item => item.price > 0)?.price || 75000;
const mesinPrice = pricing.mesin.find(item => item.price > 0)?.price || 120000;
const manualPriceStr = manualPrice.toLocaleString('id-ID');
const mesinPriceStr = mesinPrice.toLocaleString('id-ID');

const orgLd = JSON.stringify(organizationSchema());

const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": `Jasa Strauss Pile (bore pile manual) Jakarta. Harga mulai Rp${manualPriceStr}/m. Solusi lahan sempit & padat penduduk. Melayani seluruh Jakarta.`,
    "priceRange": `Rp${manualPriceStr} - Rp${mesinPriceStr}`,
    "areaServed": [
            { "@type": "City", "name": "Jakarta" }
        ]
}));
---

<BaseLayout title={`Jasa & Harga Strauss Pile Jakarta 2026 (Manual) | Mulai Rp${manualPriceStr}`}
    description={`Jasa Strauss Pile (bore pile manual) Jakarta 2026. Harga mulai Rp${manualPriceStr}/m. Solusi pondasi untuk lahan sempit & gang padat. Konsultasi gratis. Melayani seluruh Jakarta.`}
    bodyClass="services">
    <Fragment slot="head">
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta property="og:title" content={`Jasa & Harga Strauss Pile Jakarta 2026 | Mulai Rp${manualPriceStr}`}>
        <meta property="og:description" content={`Jasa Strauss Pile Jakarta. Harga mulai Rp${manualPriceStr}/m. Solusi pondasi gang sempit.`}>
        <meta property="og:type" content="website">
        <meta property="og:locale" content="id_ID">
        <meta property="og:url" content="https://agungperkasaborepile.com/jasa/strauss-pile/jakarta/">
        <meta property="og:image" content="https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp">
        <meta property="og:site_name" content="Agung Perkasa Borepile">
        
        <meta name="twitter:card" content="summary_large_image">
        <meta name="twitter:title" content="Jasa & Harga Strauss Pile Jakarta 2026">
        <meta name="twitter:description" content={`Harga Strauss Pile Jakarta mulai Rp${manualPriceStr}/m. Solusi lahan sempit. Konsultasi gratis.`}>
        
        <meta name="geo.region" content="ID-JK">
        <meta name="geo.placename" content="Jakarta">
        
        <link rel="dns-prefetch" href="https://www.googletagmanager.com">
        <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="F3ndI7tGSH1XWvznEXqZgQ" defer></script>
        
        <link rel="stylesheet" href="/css/borepile-kota.css">
    </Fragment>

    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>
    
    <main id="main-content">
        <div class="blog-container">
            <!-- ===== BREADCRUMB ===== -->
            <nav class="breadcrumb" aria-label="Breadcrumb navigasi">
                <a href="/">Beranda</a>
                <span class="separator">/</span>
                <a href="/jasa/">Jasa</a>
                <span class="separator">/</span>
                <span class="current" aria-current="page">Strauss Pile Jakarta</span>
            </nav>
            
            <!-- ===== H1 ===== -->
            <h1 class="page-title">Jasa & Harga Strauss Pile Jakarta 2026 (Bore Pile Manual) Per Meter</h1>
            
            <div class="page-meta">
                <span>Update: {new Date().toLocaleDateString('id-ID', {day: 'numeric', month: 'short', year: 'numeric'})}</span> |
                <span>Agung Perkasa</span> |
                <span>📍 Jakarta & Sekitarnya</span>
            </div>

            <div class="update-badge">
                Harga Ter-update 2026 | Solusi Gang Sempit Jakarta
            </div>

            <!-- ===== ILLUSTRATION ===== -->
            <div class="illustration">
                <div class="illustration-img">
                    <img src="/imgs/hasil-lubang-borepile.webp" alt="Proses pengerjaan Strauss Pile (bore pile manual) di gang padat Jakarta untuk pondasi bangunan" title="Strauss Pile Jakarta" width="372" height="350" fetchpriority="high">
                    <div class="caption">Proses pengeboran Strauss Pile (bore pile manual) di gang padat Jakarta</div>
                </div>
                <div class="illustration-text">
                    <p><strong>Harga jasa Strauss Pile Jakarta 2026</strong> untuk jasa pengeboran saja mulai dari <strong>Rp{manualPriceStr}/m</strong>.</p>
                    <p>Membangun rumah atau ruko di wilayah padat penduduk Jakarta seperti Tambora, Johar Baru, atau pemukiman padat di Jakarta Timur memiliki tantangan tersendiri: <strong>gang sempit dan tidak boleh ada getaran bising.</strong></p>
                    <p>Solusi terbaiknya adalah <strong>Strauss Pile (Bore Pile Manual)</strong>. Metode ini dikerjakan 100% menggunakan tenaga manusia dengan alat bor yang ringkas, sehingga material bisa dibawa masuk ke dalam gang sempit hanya menggunakan sepeda motor atau gerobak.</p>
                    <p><a href="/harga/bore-pile-2026/">Lihat daftar harga bore pile 2026 lengkap di sini</a>. Gunakan kalkulator di bawah untuk menghitung estimasi biaya proyek Strauss Pile Anda.</p>
                </div>
            </div>

            <!-- ===== KALKULATOR ===== -->
            <section aria-labelledby="calculator-heading">
                <div class="calculator-box">
                    <h2 id="calculator-heading">Kalkulator Estimasi Biaya Strauss Pile Jakarta</h2>
                    
                    <div class="method-selector" role="group" aria-label="Pilih metode bore pile">
                        <button class="method-btn" data-method="mesin" aria-pressed="false" onclick="window.location.href='/jasa/bore-pile/jakarta/'">Bore Pile Mesin</button>
                        <button class="method-btn active" data-method="manual" aria-pressed="true">Strauss Pile Manual</button>
                    </div>
                    
                    <div class="form-row">
                        <div class="calculator-form-group">
                            <label for="diameterSelect">Diameter (cm)</label>
                            <select id="diameterSelect">
                                {pricing.manual.map(p => (
                                    <option value={p.diameter} selected={p.diameter === 30}>{p.diameter} cm</option>
                                ))}
                            </select>
                        </div>
                        <div class="calculator-form-group">
                            <label for="priceInput">Harga Jasa per Meter (Rp)</label>
                            <input type="text" id="priceInput" inputmode="numeric" placeholder="Kosongkan untuk harga standar" value="">
                            <div class="price-hint">*Otomatis mengikuti tabel harga 2026</div>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="calculator-form-group">
                            <label for="depthInput">Kedalaman (meter)</label>
                            <input type="text" id="depthInput" inputmode="numeric" placeholder="Contoh: 6" value="6">
                        </div>
                        <div class="calculator-form-group">
                            <label for="pointsInput">Jumlah Titik</label>
                            <input type="number" id="pointsInput" value="15" min="1" max="500" step="1">
                        </div>
                    </div>
                    
                    <div class="calculator-result" aria-live="polite">
                        <p class="result-label">Estimasi Total Biaya JASA BOR SAJA</p>
                        <div class="total-price" id="totalPrice">Rp 0</div>
                        <div class="detail-price" id="detailPrice"></div>
                        <div class="estimation-time" id="estimationTime">Estimasi waktu: -</div>
                        <div class="order-info" id="orderInfo"></div>
                    </div>
                    
                    <button onclick="sendToWA()" class="btn-wa" aria-label="Konsultasikan ke WhatsApp">Konsultasikan ke WhatsApp</button>
                    <div class="calculator-note">*Estimasi untuk jasa pengeboran Strauss Pile. Minimal order: 100m. Akses gang sangat sempit tidak terkena tambahan biaya jika alat bisa diangkut manual.</div>
                </div>
            </section>

            <script is:inline src="/js/borepile-kota.js" defer></script>

            <!-- ===== TABEL HARGA ===== -->
            <section aria-labelledby="table-heading">
                <h2 id="table-heading" class="section-heading">Tabel Harga Strauss Pile Jakarta 2026</h2>
                <p>Harga di bawah ini merupakan tarif <strong>jasa pengeboran saja</strong> (termasuk tenaga bor, perakitan besi SNI, dan pengecoran). Material beton (readymix) dan besi tulangan disediakan oleh pemilik proyek atau bisa dipesan secara *All-In* kepada kami.</p>

                <div class="table-responsive">
                    <table class="price-table">
                        <caption>Tabel Harga Strauss Pile (Bore Pile Manual) Jakarta</caption>
                        <thead>
                            <tr><th>Diameter</th><th>Harga Jasa (Rp/m)</th><th>Kedalaman Maks</th><th>Cocok Untuk Jakarta</th></tr>
                        </thead>
                        <tbody>
                            {pricing.manual.map(p => (
                                <tr>
                                    <td>{p.diameter} cm</td>
                                    <td><strong>{p.price > 0 ? p.price.toLocaleString('id-ID') : 'Hubungi Kami'}</strong></td>
                                    <td>10 meter</td>
                                    <td>{p.suitable || 'Rumah/Ruko lahan terbatas'}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- ===== FAKTOR HARGA ===== -->
            <section aria-labelledby="factors-heading">
                <h2 id="factors-heading" class="section-heading">Keunggulan Strauss Pile di Medan Sulit Jakarta</h2>

                <div class="info-grid">
                    <div class="info-card">
                        <h3>1. Akses Gang Sempit (Motor)</h3>
                        <p>Kawasan seperti Johar Baru atau Tambora yang gangnya tidak muat mobil pick-up, alat Strauss Pile kami bisa diangkut menggunakan sepeda motor atau gerobak tarik tangan tanpa masalah.</p>
                    </div>
                    <div class="info-card">
                        <h3>2. 100% Tanpa Getaran (Zero Vibration)</h3>
                        <p>Dinding rumah tetangga yang saling menempel di pemukiman padat sangat rentan retak. Pengeboran manual memutar tanah dengan tenaga manusia menjamin nihil getaran perusak struktur sekitar.</p>
                    </div>
                    <div class="info-card">
                        <h3>3. Tidak Bising</h3>
                        <p>Proyek di kawasan perumahan elit atau cluster sering memiliki aturan ketat soal kebisingan. Strauss Pile beroperasi nyaris tanpa suara mesin menderu.</p>
                    </div>
                    <div class="info-card">
                        <h3>4. Dry Boring (Bor Kering) Tanpa Air</h3>
                        <p>Di Jakarta yang padat, membuang air bercampur lumpur tebal (mud) bekas sirkulasi pengeboran mesin sangat sulit. Strauss Pile bekerja secara kering (dry boring), sehingga tanah sisa galian bisa langsung dimasukkan karung dan dibuang rapi tanpa mengotori selokan/drainase warga.</p>
                    </div>
                </div>
            </section>

            <!-- ===== PORTOFOLIO ===== -->
            <section>
                <h2 class="section-heading-center">Portofolio Proyek Strauss Pile Kami di Jakarta</h2>
                <div class="proyek-jakarta-grid">
                    <div class="proyek-jakarta-item">
                        <img src="/imgs/hasil-lubang-borepile.webp" 
                             alt="Hasil galian Strauss Pile (bore pile manual) bersih tanpa lumpur di Jakarta" 
                             loading="lazy"
                             width="400" height="300">
                        <div class="proyek-jakarta-caption">
                            <span class="proyek-jakarta-label">Renovasi Rumah Tingkat di Cempaka Putih</span>
                            <span class="proyek-jakarta-detail">Strauss Pile Ø25cm (Kering), kedalaman 6m, 18 titik. Akses masuk gang roda dua.</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ===== KOMITMEN & GARANSI ===== -->
            <CityGuarantee />

            <!-- ===== FAQ ===== -->
            <section>
                <h2 class="section-heading">FAQ Strauss Pile (Manual) di Jakarta</h2>
                <div class="faq-container">
                    <div class="faq-item">
                        <button class="faq-question">Apakah Strauss Pile kuat untuk rumah 3 lantai di Jakarta?<FaIcon class="fas fa-chevron-down" /></button>
                        <div class="faq-answer">
                            <p>Tergantung kontur tanah dasar. Untuk Jakarta Selatan dan Timur (tanah relatif keras di kedalaman dangkal), Strauss Pile diameter 30cm atau 40cm bisa menopang beban rumah 3 lantai. Namun untuk Jakarta Utara (tanah lunak/bekas rawa), kami menyarankan pengecekan Sondir dahulu atau beralih menggunakan <strong>Bore Pile Mesin</strong> yang bisa mengebor menembus lapisan lunak hingga 30 meter.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question">Berapa biaya pengiriman alat Strauss Pile ke Jakarta?<FaIcon class="fas fa-chevron-down" /></button>
                        <div class="faq-answer">
                            <p>Biaya mobilisasi alat manual berkisar antara Rp 1.000.000 hingga Rp 1.500.000 tergantung wilayah (Jakarta Pusat/Utara lebih murah karena dekat dengan *basecamp* kami).</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question">Berapa titik Strauss Pile yang bisa dikerjakan dalam sehari?<FaIcon class="fas fa-chevron-down" /></button>
                        <div class="faq-answer">
                            <p>Satu grup pekerja (biasanya 3-4 orang) rata-rata mampu menyelesaikan 4-6 titik per hari untuk kedalaman 6 meter di kondisi tanah lempung normal Jakarta.</p>
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <!-- ===== SCHEMA MARKUP ===== -->
    <script type="application/ld+json" set:html={orgLd} />
    <script type="application/ld+json" set:html={localBusinessLd} />
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://agungperkasaborepile.com/" },
            { "@type": "ListItem", "position": 2, "name": "Jasa", "item": "https://agungperkasaborepile.com/jasa/" },
            { "@type": "ListItem", "position": 3, "name": "Strauss Pile Jakarta", "item": "https://agungperkasaborepile.com/jasa/strauss-pile/jakarta/" }
        ]
    }
    </script>
</BaseLayout>
