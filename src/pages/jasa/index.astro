---
import config from '../../data/config.json';
import pricing from '../../data/harga.json';
import { organizationSchema, schemaPhone } from '../../lib/schema.js';

const orgLd = JSON.stringify(organizationSchema({
    "alternateName": "Agung Perkasa Bore Pile",
    "logo": {
        "@type": "ImageObject",
        "url": "https://agungperkasaborepile.com/imgs/logo-agung-perkasa-transparan.png"
    },
    "description": "Spesialis pondasi bore pile dan strauss pile melayani Jabodetabek dan seluruh Jawa.",
    "telephone": schemaPhone,
    "email": config.company.email
}));

const formatPrice = (value) => `Rp${value.toLocaleString('id-ID')}`;
const mesinMulai = formatPrice(pricing.mesin.find((item) => item.price > 0).price);
const manualMulai = formatPrice(pricing.manual.find((item) => item.price > 0).price);
const formattedUpdate = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));
