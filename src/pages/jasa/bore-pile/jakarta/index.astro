---
import pricing from '../../../../data/harga.json';
import jakartaData from '../../../../data/kota/jakarta.json';
import { organizationSchema, localBusinessSchema } from '../../../../lib/schema.js';

import NavbarKota from '../../../../components/shared/NavbarKota.astro';
import CityHero from '../../../../components/city/CityHero.astro';
import CityCalculator from '../../../../components/city/CityCalculator.astro';
import PriceTable from '../../../../components/shared/PriceTable.astro';
import CityFactors from '../../../../components/city/CityFactors.astro';
import CityProjects from '../../../../components/city/CityProjects.astro';
import CityEquipment from '../../../../components/city/CityEquipment.astro';
import CityPortfolio from '../../../../components/city/CityPortfolio.astro';
import CityKecamatan from '../../../../components/city/CityKecamatan.astro';
import FaqSection from '../../../../components/shared/FaqSection.astro';
import CityArticles from '../../../../components/city/CityArticles.astro';
import CityInternalLinks from '../../../../components/city/CityInternalLinks.astro';
import CtaWhatsApp from '../../../../components/shared/CtaWhatsApp.astro';
import FooterKota from '../../../../components/shared/FooterKota.astro';

// SEO & Schema
const orgLd = JSON.stringify(organizationSchema());
const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": jakartaData.localBusinessDesc,
    "areaServed": [
        { "@type": "City", "name": jakartaData.name }
    ]
}));

// Format harga & tanggal untuk meta deskripsi
const mesinMulai = pricing.mesin.find((item) => item.price > 0)?.price.toLocaleString('id-ID') || "120.000";
const manualMulai = pricing.manual.find((item) => item.price > 0)?.price.toLocaleString('id-ID') || "70.000";
---

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#1a3a6e">
    
    <title>Jasa & Harga Bore Pile Jakarta Terpercaya | Agung Perkasa</title>
    
    <meta name="description" content={`Jasa Bore Pile & Strauss Pile ${jakartaData.name} terpercaya. Harga mesin mulai Rp${mesinMulai}/m, manual Rp${manualMulai}/m. Melayani seluruh ${jakartaData.name}.`}>
    <meta name="robots" content="index, follow">
    <meta name="google-site-verification" content="QjaIirR3-qW7bARIyez5S0_WPeMjPJSqn6tnK44ZYMo">
    
    <link rel="canonical" href={`https://agungperkasaborepile.com/jasa/bore-pile/${jakartaData.slug}.html`} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    
    <!-- Open Graph -->
    <meta property="og:title" content="Jasa & Harga Bore Pile Jakarta 2026 | Agung Perkasa">
    <meta property="og:description" content="Jasa Bore Pile Jakarta terpercaya. Harga Mesin mulai dari Rp120.000/m, manual Rp70.000/m. Konsultasi gratis. Melayani seluruh Jakarta.">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="id_ID">
    <meta property="og:url" content={`https://agungperkasaborepile.com/jasa/bore-pile/${jakartaData.slug}.html`}>
    <meta property="og:image" content="https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp">
    <meta property="og:site_name" content="Agung Perkasa Borepile">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Jasa & Harga Bore Pile Jakarta 2026">
    <meta name="twitter:description" content="Harga bore pile Jakarta mulai Rp70.000/m (manual) & Rp120.000/m (mesin). Kalkulator bore pile. Konsultasi gratis. Melayani seluruh Jakarta.">
    <meta name="twitter:image" content="https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp">
    
    <!-- Geo Tags -->
    <meta name="geo.region" content={jakartaData.geoRegion}>
    <meta name="geo.placename" content={jakartaData.geoPlacename}>
    
    <!-- Preconnect -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">

    <!-- Ahrefs Analytics -->
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="F3ndI7tGSH1XWvznEXqZgQ" defer></script>
    
    <!-- CSS EKSTERNAL -->
    <link rel="stylesheet" href="/css/borepile-kota.css">
    <link rel="stylesheet" href="/css/lightbox.css">
    
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={orgLd}></script>
    <script type="application/ld+json" set:html={localBusinessLd}></script>
</head>
<body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P6GBTKJB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    
    <!-- Google Tag Manager (Deffered load) -->
    <script>window.addEventListener('load',function(){(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-P6GBTKJB');});</script>
    <!-- End Google Tag Manager -->
    
    <!-- Google tag (gtag.js) - Google Ads -->
    <script defer src="https://www.googletagmanager.com/gtag/js?id=AW-16649506462"></script>
    <script>
      window.addEventListener('load', function() {
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'AW-16649506462');
      });
    </script>
    
    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>
    
    <NavbarKota citySlug={jakartaData.slug} cityName={jakartaData.name} variant="kota" />
    
    <main id="main-content">
        <CityHero data={jakartaData} cityName={jakartaData.name} />
        
        <CityCalculator cityName={jakartaData.name} />
        <PriceTable localPrices={jakartaData.localPrices} />
        
        <CityFactors factors={jakartaData.factors} cityName={jakartaData.name} />
        <CityProjects projects={jakartaData.projects} cityName={jakartaData.name} />
        <CityEquipment equipment={jakartaData.equipment} cityName={jakartaData.name} />
        <CityPortfolio portfolio={jakartaData.portfolio} cityName={jakartaData.name} />
        <CityKecamatan kecamatan={jakartaData.kecamatan} cityName={jakartaData.name} />
        
        <FaqSection faq={jakartaData.faq} />
        
        <CityArticles articles={jakartaData.articles} />
        <CityInternalLinks internalLinks={jakartaData.internalLinks} />
    </main>
    
    <!-- Floating WhatsApp CTA -->
    <CtaWhatsApp cityName={jakartaData.name} />
    
    <!-- Footer -->
    <FooterKota cityName={jakartaData.name} footerDescription={jakartaData.localBusinessDesc} mapsNote="Kantor Pusat: Jakarta" />
    
    <!-- JavaScript Khusus Halaman Kota -->
    <script src="/js/jasa.js" defer></script>
    <script src="/js/harga-calculator.js" defer></script>
    <script src="/js/lightbox.js" defer></script>
</body>
</html>