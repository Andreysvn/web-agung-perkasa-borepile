---
import config from '../../data/config.json';
import { organizationSchema, schemaPhone } from '../../lib/schema.js';

import FaIcon from '../../components/icons/FaIcon.astro';
import Navbar from '../../components/global/Navbar.astro';
import Footer from '../../components/global/Footer.astro';
const orgLd = JSON.stringify(organizationSchema({
    "alternateName": "Agung Perkasa Bore Pile",
    "description": "Spesialis pondasi bore pile dan strauss pile melayani Jabodetabek dan seluruh Jawa.",
    "telephone": schemaPhone,
    "email": config.company.email,
    "logo": {"@type":"ImageObject","url":"https://agungperkasaborepile.com/imgs/logo-agung-perkasa-transparan.png"}
}));
---
<!DOCTYPE html>
<html lang="id">
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
    <meta name="theme-color" content="#1a3a6e">

    <title>Layanan Agung Perkasa | Jasa Bore Pile & Strauss Pile</title>

    <meta name="description" content="Pusat layanan jasa bore pile dan strauss pile untuk seluruh Indonesia. Temukan kontraktor pondasi dalam terbaik di kota Anda. Konsultasi gratis.">
    <meta name="robots" content="index, follow">
    <meta name="google-site-verification" content="QjaIirR3-qW7bARIyez5S0_WPeMjPJSqn6tnK44ZYMo">

    <link rel="canonical" href="https://agungperkasaborepile.com/alat.html" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content="Pusat Layanan Pondasi Dalam | Jasa Bore Pile & Strauss Pile Indonesia">
    <meta property="og:description" content="Pusat layanan jasa bore pile dan strauss pile untuk seluruh Indonesia. Konsultasi gratis.">
    <meta property="og:type" content="website">
    <meta property="og:locale" content="id_ID">
    <meta property="og:url" content="https://agungperkasaborepile.com/alat.html">
    <meta property="og:image" content="https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp">
    <meta property="og:site_name" content="Agung Perkasa Borepile">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Pusat Layanan Pondasi Dalam Indonesia">
    <meta name="twitter:description" content="Temukan jasa bore pile dan strauss pile terbaik di kota Anda.">
    <meta name="twitter:image" content="https://agungperkasaborepile.com/imgs/logo-agung-perkasa.webp">

    <!-- Preconnect -->
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">

    <!-- Font Awesome -->
    <!-- Ahrefs Analytics -->
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="F3ndI7tGSH1XWvznEXqZgQ" defer></script>

    <!-- CSS -->
    <link rel="stylesheet" href="/css/jasa.css">
</head>
<body>
     <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-P6GBTKJB');</script>
    <!-- End Google Tag Manager -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P6GBTKJB" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>

    <a href="#main-content" class="skip-link">Langsung ke konten utama</a>

    <Navbar />

    <!-- ===== MAIN ===== -->
    <main id="main-content">
        <div class="blog-container">

            <!-- ===== BREADCRUMB ===== -->
            <nav class="breadcrumb" aria-label="Breadcrumb navigasi">
                <a href="/">Beranda</a>
                <span class="separator">/</span>
                <span class="current" aria-current="page">Jasa</span>
            </nav>

            <!-- ===== HERO ===== -->
            <section class="jasa-hero">
                <span class="hero-badge"> Agung Perkasa</span>
                <h1>Jasa Bore Pile dan Strauss Pile</h1>
                <p>Temukan layanan agung perkasa untuk kota Anda. Konsultasi gratis hubungi kami.</p>
            </section>

           <!-- ===== PILIH JENIS LAYANAN ===== -->
<section class="service-type-section">
    <p class="section-label">Pilih Layanan</p>
    <h2>Pilih Jenis Layanan Anda</h2>
    <p class="section-sub">Pilih metode pondasi yang sesuai dengan kebutuhan proyek Anda</p>

    <div class="service-type-grid">

        <!-- ===== BORE PILE ===== -->
        <a href="/jasa/bore-pile/" class="service-type-card-with-image">
            <div class="card-img-wrapper">
                <img src="/imgs/borepile-mesin-biru.webp" 
                     alt="Jasa Bore Pile menggunakan mesin mini crane untuk pondasi dalam metode bore pile wash boring" 
                     loading="lazy">
            </div>
            <div class="card-body">
                <h3>Bore Pile</h3>
                <p class="card-sub">Mesin Mini Crane, Gawangan, Mini Pile</p>
                <p>Solusi pondasi dalam untuk rumah tinggal, ruko, jembatan, gudang, gedung bertingkat. diameter 30-80cm, kedalaman hingga 30m.</p>
                <span class="btn-type btn-type-primary">
                    Cari Lokasi <FaIcon class="fas fa-arrow-right" />
                </span>
            </div>
        </a>

        <!-- ===== STRAUSS PILE ===== -->
        <a href="/jasa/strauss-pile/jakarta.html" class="service-type-card-with-image">
            <div class="card-img-wrapper">
                <img src="/imgs/borepile-pondasi-rumah.jpg" 
                     alt="Jasa Strauss Pile manual untuk pondasi rumah tinggal" 
                     loading="lazy">
            </div>
            <div class="card-body">
                <h3>Strauss Pile</h3>
                <p class="card-sub">Manual</p>
                <p>Solusi ekonomis untuk rumah tinggal, ruko, dan proyek dengan lahan terbatas. Pengerjaan cepat dan fleksibel.</p>
                <span class="btn-type btn-type-secondary">
                    Cari Lokasi <FaIcon class="fas fa-arrow-right" />
                </span>
            </div>
        </a>

    </div>
</section>
            <!-- ============================================================
                 KENAPA MEMILIH KAMI
                 ============================================================ -->
            <section class="why-section">
                <div class="section-header">
                    <h2>Kenapa Memilih Kami?</h2>
                    <p>Lebih dari 10 tahun pengalaman dalam pondasi dalam</p>
                </div>
                <div class="why-grid">
                    <div class="why-card">
                        <h4>Garansi Mutu Beton</h4>
                        <p>K225-K300 sesuai SNI</p>
                    </div>
                    <div class="why-card">
                        <h4>Tenaga Ahli</h4>
                        <p>Pengalaman 10+ tahun</p>
                    </div>
                    <div class="why-card">
                        <h4>Efisien Waktu</h4>
                        <p>Seluruh Pulau Jawa</p>
                    </div>
                    <div class="why-card">
                        <h4>Harga Transparan</h4>
                        <p>Biaya terjangkau</p>
                    </div>
                </div>
            </section>

            <!-- ============================================================
     ALAT YANG KAMI GUNAKAN
     ============================================================ -->
<section class="equipment-section">
    <div class="section-header">
        <h2>Alat yang Kami Gunakan</h2>
        <p>Kami memiliki berbagai jenis alat bore pile untuk menyesuaikan dengan kebutuhan proyek Anda</p>
    </div>

    <div class="equipment-grid">

        <!-- MINI CRANE -->
        <a id="bore-pile" href="/alat/mini-crane/" class="equipment-card">
            <div class="equip-img-wrapper">
                <img src="/imgs/icons/bore-pile-mesin-mini-crane-icon-agung-perkasa.svg" 
                     alt="Mesin bore pile mini crane" 
                     loading="lazy">
            </div>
            <div class="equip-body">
                <div class="equip-header">
                    <div class="equip-icon">
                        <img src="/imgs/logo-agung-perkasa.webp" alt="" loading="lazy">
                    </div>
                    <h3>Mini Crane</h3>
                </div>
                <p class="equip-sub">Kapasitas Sedang</p>
                <p>Diameter 30-80cm, kedalaman hingga 30m. Cocok untuk rumah, ruko, gudang, dan bangunan bertingkat.</p>
                <div class="equip-tags">
                    <span class="tag-primary">30-80 cm</span>
                    <span class="tag-secondary">30 m</span>
                    <span>Mesin</span>
                </div>
                <span class="equip-link">Lihat Detail <FaIcon class="fas fa-arrow-right" /></span>
            </div>
        </a>

        <!-- GAWANGAN -->
        <a href="/alat/gawangan/" class="equipment-card">
            <div class="equip-img-wrapper">
                <img src="/imgs/icons/bore-pile-mesin-gawangan-icon-agung-perkasa.svg" 
                     alt="Mesin bore pile gawangan" 
                     loading="lazy">
            </div>
            <div class="equip-body">
                <div class="equip-header">
                    <div class="equip-icon">
                        <img src="/imgs/logo-agung-perkasa.webp" alt="" loading="lazy">
                    </div>
                    <h3>Gawangan</h3>
                </div>
                <p class="equip-sub">Area Sempit</p>
                <p>Cocok untuk area yang tidak bisa diakses mini crane. Diameter 30-80cm untuk proyek di gang sempit.</p>
                <div class="equip-tags">
                    <span class="tag-primary">30-80 cm</span>
                    <span class="tag-secondary">30 m</span>
                    <span>Mesin</span>
                </div>
                <span class="equip-link">Lihat Detail <FaIcon class="fas fa-arrow-right" /></span>
            </div>
        </a>

        <!-- STRAUSS PILE -->
        <a id="strauss-pile" href="/alat/strauss-pile/" class="equipment-card">
            <div class="equip-img-wrapper">
                <img src="/imgs/icons/strauss-pile-icon-agung-perkasa.svg" 
                     alt="Strauss pile bore pile manual" 
                     loading="lazy">
            </div>
            <div class="equip-body">
                <div class="equip-header">
                    <div class="equip-icon">
                        <img src="/imgs/logo-agung-perkasa.webp" alt="" loading="lazy">
                    </div>
                    <h3>Strauss Pile</h3>
                </div>
                <p class="equip-sub">Manual / Bor Tangan</p>
                <p>Alat bor manual full tenaga manusia. Diameter 20-40cm, cocok untuk gang sempit dan area terbatas.</p>
                <div class="equip-tags">
                    <span class="tag-primary">20-40 cm</span>
                    <span class="tag-secondary">10 m</span>
                    <span>Manual</span>
                </div>
                <span class="equip-link">Lihat Detail <FaIcon class="fas fa-arrow-right" /></span>
            </div>
        </a>

    </div>
</section>
            <!-- ============================================================
                 FAQ
                 ============================================================ -->
            <section class="faq-section">
                <div class="section-header">
                    <h2>Pertanyaan Umum</h2>
                    <p>Jawaban atas pertanyaan yang sering diajukan</p>
                </div>
                <div class="faq-container">
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            Apa perbedaan Bore Pile dan Strauss Pile?
                            <FaIcon class="fas fa-chevron-down" />
                        </button>
                        <div class="faq-answer">
                            <p><strong>Bore Pile</strong> menggunakan mesin mini crane atau gawangan, cocok untuk rumah, ruko, gudang, dan bangunan bertingkat. <strong>Strauss Pile</strong> dikerjakan secara manual, lebih ekonomis dan cocok untuk rumah tinggal atau ruko.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            Berapa biaya bore pile per meter?
                            <FaIcon class="fas fa-chevron-down" />
                        </button>
                        <div class="faq-answer">
                            <p>Harga mulai dari <strong>Rp75.000 - Rp120.000/meter</strong> tergantung diameter, kedalaman, dan jenis alat yang digunakan. Untuk penawaran spesifik, silakan konsultasi gratis melalui WhatsApp.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            Apakah melayani proyek skala kecil (rumah tinggal)?
                            <FaIcon class="fas fa-chevron-down" />
                        </button>
                        <div class="faq-answer">
                            <p>Ya! Kami melayani berbagai skala proyek, dari rumah tinggal 1 lantai hingga gedung bertingkat tinggi. Untuk proyek kecil, kami rekomendasikan <strong>Strauss Pile</strong> yang lebih ekonomis.</p>
                        </div>
                    </div>
                    <div class="faq-item">
                        <button class="faq-question" aria-expanded="false">
                            Berapa lama waktu pengerjaan?
                            <FaIcon class="fas fa-chevron-down" />
                        </button>
                        <div class="faq-answer">
                            <p>Waktu pengerjaan bervariasi tergantung jumlah titik dan kedalaman. Rata-rata <strong>3-4 titik per hari</strong> untuk bore pile mesin, dan <strong>2-3 titik per hari</strong> untuk strauss pile manual.</p>
                        </div>
                    </div>
                </div>
            </section>

            <!-- ============================================================
                 CTA
                 ============================================================ -->
            <section class="jasa-cta-box">
                <h3> Hubungi Kami</h3>
                <p>Konsultasi gratis. Kami akan membantu menghitung estimasi biaya dan memilih metode terbaik.</p>
                <a href={`https://wa.me/${config.company.whatsapp}?text=Halo%20Pak%2C%20Saya%20dari%20website%20Pusat%20Layanan%20ingin%20konsultasi%20soal%20bore%20pile.`} class="btn-wa-cta" target="_blank" rel="noopener noreferrer">
                    <FaIcon class="fab fa-whatsapp" /> Konsultasi Gratis via WhatsApp
                </a>
            </section>

        </div>
    </main>

    <!-- ===== WHATSAPP FLOAT ===== -->
    <a href={`https://wa.me/${config.company.whatsapp}?text=Halo%20Pak%2C%20Saya%20dari%20website%20Pusat%20Layanan%20ingin%20konsultasi%20soal%20bore%20pile.`} class="whatsapp-float" target="_blank" rel="noopener noreferrer" aria-label="Chat konsultasi melalui WhatsApp">
        <FaIcon class="fab fa-whatsapp" />
    </a>

    <!-- ===== SCROLL TOP ===== -->
    <button class="scroll-top" id="scrollTop" aria-label="Kembali ke atas">
        <FaIcon class="fas fa-arrow-up" />
    </button>

    <Footer />
    <!-- ===== JS EXTERNAL ===== -->
    <script is:inline src="/js/jasa.js" defer></script>

    <!-- ============================================================
         SCHEMA
         ============================================================ -->
    <script type="application/ld+json" set:html={orgLd} />

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "Beranda",
                "item": "https://agungperkasaborepile.com/"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "Pusat Layanan",
                "item": "https://agungperkasaborepile.com/jasa/"
            }
        ]
    }
    </script>

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "Apa perbedaan Bore Pile dan Strauss Pile?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Bore Pile menggunakan mesin mini crane atau gawangan, cocok untuk rumah, ruko, gudang, dan bangunan bertingkat. Strauss Pile dikerjakan secara manual, lebih ekonomis dan cocok untuk rumah tinggal atau ruko."
                }
            },
            {
                "@type": "Question",
                "name": "Berapa biaya bore pile per meter?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Harga mulai dari Rp75.000 - Rp120.000/meter tergantung diameter, kedalaman, dan jenis alat yang digunakan."
                }
            },
            {
                "@type": "Question",
                "name": "Apakah melayani proyek skala kecil (rumah tinggal)?",
                "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Ya! Kami melayani berbagai skala proyek, dari rumah tinggal 1 lantai hingga gedung bertingkat tinggi."
                }
            }
        ]
    }
    </script>

</body>
</html>