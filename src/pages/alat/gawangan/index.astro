---
import pricing from '../../../data/harga.json';
const manualPrice = pricing.manual.find(i => i.price > 0)?.price || 75000;
const mesinPrice = pricing.mesin.find(i => i.price > 0)?.price || 120000;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import config from '../../../data/config.json';
const dateObj = new Date(config.lastUpdated);
const formattedDate = dateObj.toLocaleDateString('id-ID', { day: '2-digit', month: 'long', year: 'numeric' });
import { organizationSchema, schemaPhone } from '../../../lib/schema.js';

import FaIcon from '../../../components/icons/FaIcon.astro';
const orgLd = JSON.stringify(organizationSchema({
    "alternateName": "Agung Perkasa Bore Pile",
    "description": "Mesin gawangan bore pile dengan sistem knock-down. Spesifikasi setara mini crane, sangat fleksibel untuk medan sulit, lahan miring, dan area padat penduduk.",
    "telephone": schemaPhone,
    "email": config.company.email,
    "logo": {"@type":"ImageObject","url":"https://agungperkasaborepile.com/imgs/logo-agung-perkasa-transparan.png"}
}));
