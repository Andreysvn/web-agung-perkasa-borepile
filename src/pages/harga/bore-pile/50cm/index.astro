---
import config from '../../../../data/config.json';
import KotaLayout from '../../../../layouts/KotaLayout.astro';
import pricing from '../../../../data/harga.json';
import { organizationSchema, localBusinessSchema } from '../../../../lib/schema.js';
import FaIcon from '../../../../components/icons/FaIcon.astro';

// Components
import CityCalculator from '../../../../components/city/CityCalculator.astro';

const m30 = pricing.mesin.find(p => p.diameter === 30).price.toLocaleString('id-ID');
const m40 = pricing.mesin.find(p => p.diameter === 40).price.toLocaleString('id-ID');
const m50 = pricing.mesin.find(p => p.diameter === 50).price.toLocaleString('id-ID');
const mn20 = pricing.manual.find(p => p.diameter === 20).price.toLocaleString('id-ID');
const mn25 = pricing.manual.find(p => p.diameter === 25).price.toLocaleString('id-ID');
const mn30 = pricing.manual.find(p => p.diameter === 30).price.toLocaleString('id-ID');
const mn40 = pricing.manual.find(p => p.diameter === 40).price.toLocaleString('id-ID');

const orgLd = JSON.stringify(organizationSchema());

const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": `Jasa bore pile diameter 50cm terpercaya dengan pengalaman lebih dari 10 tahun. Harga bore pile mesin mulai Rp${m50}/m.`,
    "areaServed": [
        { "@type": "City", "name": "Jakarta" },
        { "@type": "City", "name": "Bekasi" },
        { "@type": "City", "name": "Depok" },
        { "@type": "City", "name": "Tangerang" },
        { "@type": "City", "name": "Bogor" }
    ]
}));

const formattedUpdate = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));

const formattedMonthYear = new Intl.DateTimeFormat('id-ID', {
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));
---

<KotaLayout 
    title="Harga Bore Pile 50cm Terbaru 2026 Per Meter | Agung Perkasa"
    description={`Harga bore pile diameter 50cm terbaru 2026 seluruh Pulau Jawa. Mesin mulai Rp${m50}/m. Kalkulator estimasi biaya. Konsultasi gratis.`}
    canonical="https://agungperkasaborepile.com/harga/bore-pile/50cm.html"
    schema={[orgLd, localBusinessLd]}
    extraCss={["/css/harga-komponen.css"]}
    faqSchema={[
        { q: "Apakah bore pile diameter 50cm cukup kuat untuk gudang 2 lantai?", a: "Sangat cukup. Dengan daya dukung 40-60 ton per titik, diameter 50cm mampu menahan beban gudang 2 lantai dengan aman. Bahkan untuk gudang 3 lantai pun masih kuat dengan kedalaman yang tepat." },
        { q: "Berapa standar harga jasa bor diameter 50cm?", a: "Standar harga jasa bor diameter 50cm: mesin Rp{m50}/m untuk jasa pengeboran, perakitan besi tulangan, dan pengecoran beton (harga belum termasuk material)." },
        { q: "Apakah bore pile diameter 50cm bisa dikerjakan manual?", a: "Tidak direkomendasikan. Bore pile manual maksimal hanya mampu diameter 40cm. Untuk diameter 50cm, kami wajib menggunakan mesin mini crane untuk hasil yang maksimal dan sesuai standar." },
        { q: "Berapa jumlah titik ideal untuk bore pile diameter 50cm?", a: "Untuk gudang atau pabrik dengan luas 300-500m&#xB2;, jumlah titik ideal antara 20-35 titik. Untuk ruko besar dengan luas 200-300m&#xB2;, jumlah titik ideal antara 16-25 titik. Konsultasikan dengan tim teknis kami untuk perhitungan yang akurat sesuai gambar bangunan." },
        { q: "Apakah melayani area Bekasi, Tangerang, Bogor?", a: "Betul. Kami melayani area Jabodetabek (Jakarta, Bekasi, Bogor, Depok, Tangerang) untuk proyek diameter 50cm." },
        { q: "Apakah melayani area luar Jabodetabek?", a: "Ya. Kami melayani seluruh area pulau Jawa untuk proyek skala besar dengan diameter 50cm." },
        { q: "Berapa kedalaman maksimal bore pile diameter 50cm?", a: "Untuk bore pile mesin (mini crane) diameter 50cm, kedalaman maksimal mencapai 30 meter. Kedalaman yang dibutuhkan tergantung pada kondisi tanah dan hasil uji sondir di lokasi proyek Anda." },
        { q: "Berapa biaya total bore pile 50cm untuk gudang?", a: "Untuk gudang dengan luas 300-500m&#xB2;, biasanya membutuhkan 20-35 titik bore pile diameter 50cm dengan kedalaman 10-15 meter. Estimasi biaya jasa bor (belum termasuk material): Mesin (Mini Crane): Rp{m50}/m &#x00D7; 12m &#x00D7; 25 titik = Rp57.000.000 + mobilisasi Rp3-3,5jt. Gunakan kalkulator di atas untuk menghitung estimasi biaya proyek Anda secara lebih akurat." }
    ]}
    breadcrumbItems={[
        { name: "Beranda", url: "/" },
        { name: "Harga", url: "/harga/bore-pile-2026.html" },
        { name: "Harga Bore Pile Diameter 50cm", url: "/harga/bore-pile/50cm.html" }
    ]}
