    <h3>Bore Pile Mesin (Mini Crane)</h3>
    <div class="table-responsive">
        <table class="price-table">
            <caption>Tabel harga bore pile mesin (mini crane) per meter</caption>
            <thead>
                <tr><th>Diameter</th><th>Harga (Rp/m)</th><th>Kedalaman Maks</th><th>Cocok Untuk</th></tr>
            </thead>
            <tbody>
                <tr><td>30 cm</td><td>{m30}</td><td>30 meter</td><td>Rumah 1-2 lantai</td></tr>
                <tr><td>40 cm</td><td>{m40}</td><td>30 meter</td><td>Ruko, kantor 2-3 lantai</td></tr>
                <tr class="row-highlight">
                    <td><strong>50 cm</strong></td>
                    <td><strong>{m50}</strong></td>
                    <td><strong>30 meter</strong></td>
                    <td><strong>Gudang, pabrik kecil, ruko besar 3-4 lantai, showroom</strong></td>
                </tr>
