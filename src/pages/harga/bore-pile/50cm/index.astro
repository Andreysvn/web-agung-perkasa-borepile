---
import config from '../../../../data/config.json';
import KotaLayout from '../../../../layouts/KotaLayout.astro';
import pricing from '../../../../data/harga.json';
import pageData from '../../../../data/harga-diameter/50cm.json';
import { organizationSchema, localBusinessSchema } from '../../../../lib/schema.js';
import FaIcon from '../../../../components/icons/FaIcon.astro';

// Components
import CityCalculator from '../../../../components/city/CityCalculator.astro';

// Format harga dari data pricing
const m30 = pricing.mesin.find(p => p.diameter === 30).price.toLocaleString('id-ID');
const m40 = pricing.mesin.find(p => p.diameter === 40).price.toLocaleString('id-ID');
const m50 = pricing.mesin.find(p => p.diameter === 50).price.toLocaleString('id-ID');
const mn20 = pricing.manual.find(p => p.diameter === 20).price.toLocaleString('id-ID');
const mn25 = pricing.manual.find(p => p.diameter === 25).price.toLocaleString('id-ID');
const mn30 = pricing.manual.find(p => p.diameter === 30).price.toLocaleString('id-ID');
const mn40 = pricing.manual.find(p => p.diameter === 40).price.toLocaleString('id-ID');

// Map harga ke variable untuk template
const priceMap = { m30, m40, m50, mn20, mn25, mn30, mn40 };
const mesinPrice = priceMap[`m${pageData.diameterNum}`] || '<span class="text-konsultasi">Hubungi Kami</span>';
const manualPrice = priceMap[`mn${pageData.diameterNum}`] || '';

const orgLd = JSON.stringify(organizationSchema());

const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": pageData.localBusinessDescTemplate.replace('{mesin}', mesinPrice).replace('{manual}', manualPrice || ''), 
    "areaServed": [
        { "@type": "City", "name": "Jakarta" },
        { "@type": "City", "name": "Bekasi" },
        { "@type": "City", "name": "Depok" },
        { "@type": "City", "name": "Tangerang" },
        { "@type": "City", "name": "Bogor" }
    ],
    ...(pageData.priceRange ? { "priceRange": pageData.priceRange } : {})
}));

const formattedUpdate = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));

const formattedMonthYear = new Intl.DateTimeFormat('id-ID', {
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));

const seoDesc = pageData.descriptionTemplate.replace('{mesin}', mesinPrice).replace('{manual}', manualPrice || '');
---

<KotaLayout 
    title={pageData.title}
    description={seoDesc}
    canonical={pageData.canonical}
    schema={[orgLd, localBusinessLd]}
    extraCss={["/css/harga-komponen.css"]}
    faqSchema={pageData.faq}
    breadcrumbItems={pageData.breadcrumbs}
>
    <nav class="breadcrumb" aria-label="Breadcrumb navigasi">
                {pageData.breadcrumbs.map((item, i) => (
                    i < pageData.breadcrumbs.length - 1 ? (
                        <><a href={item.url}>{item.name}</a><span class="separator">/</span></>
                    ) : (
                        <span class="current" aria-current="page">{item.name}</span>
                    )
                ))}
            </nav>
            
            <div class="update-badge">
                Harga terbaru {formattedMonthYear} | Konsultasi gratis
            </div>

            <div class="diameter-badge">
                {pageData.badge}
            </div>

            <h1 class="page-title">{pageData.h1}</h1>

            <div class="page-meta">
                <span>Update: {formattedUpdate}</span> |
                <span>Agung Perkasa</span> |
                <span>📍 Melayani JABODETABEK & Seluruh Pulau Jawa</span>
            </div>

            <div class="illustration-row">
                <div class="illustration-img">
                    <img src={pageData.heroImage} alt={pageData.heroAlt} loading="lazy" width="400" height="250">
                    <div class="caption">{pageData.heroCaption}</div>
                </div>
                <div class="illustration-text">
                    <p set:html={pageData.heroText}></p>
                    <p><a href="/harga/bore-pile-2026.html">Lihat daftar harga bore pile 2026 lengkap di sini</a>.</p>
                </div>
            </div>

            <CityCalculator cityName={pageData.diameter} defaultDiameter={pageData.defaultDiameter} />

            <!-- ===== SECTION TABEL HARGA ===== -->
<section aria-labelledby="table-heading">
    <h2 id="table-heading" class="section-heading">Tabel Harga Bore Pile {pageData.diameter} Terbaru 2026 (Jasa Bor Saja)</h2>
    <p set:html={pageData.priceTableNote}></p>

    <h3>Bore Pile Mesin (Mini Crane &amp; Gawangan)</h3>
        <div class="table-responsive">
            <table class="price-table">
                <caption>Tabel harga bore pile mesin (mini crane &amp; gawangan) per meter</caption>
                <thead>
                    <tr><th>Diameter</th><th>Harga (Rp/m)</th><th>Kedalaman Maks</th><th>Cocok Untuk</th></tr>
                </thead>
                <tbody>
                    {pageData.diameterNum === 30 ? (
                        <tr class="row-highlight">
                            <td><strong>{pageData.mesinHighlight?.diameter}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.price || m30}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.maxDepth}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.suitable}</strong></td>
                        </tr>
                    ) : (
                        <tr><td>30 cm</td><td>{m30}</td><td>30 meter</td><td>Rumah 1-2 lantai</td></tr>
                    )}
                    {pageData.diameterNum === 40 ? (
                        <tr class="row-highlight">
                            <td><strong>{pageData.mesinHighlight?.diameter}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.price || m40}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.maxDepth}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.suitable}</strong></td>
                        </tr>
                    ) : (
                        <tr><td>40 cm</td><td>{m40}</td><td>30 meter</td><td>Ruko, kantor 2-3 lantai</td></tr>
                    )}
                    {pageData.diameterNum === 50 ? (
                        <tr class="row-highlight">
                            <td><strong>{pageData.mesinHighlight?.diameter}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.price || m50}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.maxDepth}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.suitable}</strong></td>
                        </tr>
                    ) : (
                        <tr><td>50 cm</td><td>{m50}</td><td>30 meter</td><td>Gudang, pabrik kecil</td></tr>
                    )}
                    {pageData.diameterNum === 60 ? (
                        <tr class="row-highlight">
                            <td><strong>{pageData.mesinHighlight?.diameter}</strong></td>
                            <td><strong><span set:html={pageData.mesinHighlight?.price || '<span class="text-konsultasi">Hubungi Kami</span>'}></span></strong></td>
                            <td><strong>{pageData.mesinHighlight?.maxDepth}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.suitable}</strong></td>
                        </tr>
                    ) : (
                        <tr><td>60 cm</td><td><span class="text-konsultasi">Hubungi Kami</span></td><td>30 meter</td><td>Hotel 3-4 lantai, gedung 4-5 lantai, rumah sakit</td></tr>
                    )}
                    {pageData.diameterNum === 80 ? (
                        <tr class="row-highlight">
                            <td><strong>{pageData.mesinHighlight?.diameter}</strong></td>
                            <td><strong><span set:html={pageData.mesinHighlight?.price || '<span class="text-konsultasi">Hubungi Kami</span>'}></span></strong></td>
                            <td><strong>{pageData.mesinHighlight?.maxDepth}</strong></td>
                            <td><strong>{pageData.mesinHighlight?.suitable}</strong></td>
                        </tr>
                    ) : (
                        <tr><td>80 cm</td><td><span class="text-konsultasi">Hubungi Kami</span></td><td>30 meter</td><td>Gedung 5-8 lantai, apartemen, hotel</td></tr>
                    )}
                </tbody>
            </table>
        </div>

    {pageData.showManualHighlight !== false && (
    <Fragment>
        <h3>Bore Pile Manual (Strauss Pile)</h3>
        <div class="table-responsive">
            <table class="price-table">
                <caption>Tabel harga bore pile manual (strauss pile) per meter</caption>
                <thead>
                    <tr><th>Diameter</th><th>Harga (Rp/m)</th><th>Kedalaman Maks</th><th>Cocok Untuk</th></tr>
                </thead>
                <tbody>
                    <tr><td>20 cm</td><td>{mn20}</td><td>10 meter</td><td>Area sangat sempit</td></tr>
                    <tr><td>25 cm</td><td>{mn25}</td><td>10 meter</td><td>Gang kecil</td></tr>
                    {pageData.diameterNum === 30 ? (
                        <tr class="row-highlight">
                            <td><strong>{pageData.manualHighlight?.diameter}</strong></td>
                            <td><strong>{pageData.manualHighlight?.price || mn30}</strong></td>
                            <td><strong>{pageData.manualHighlight?.maxDepth}</strong></td>
                            <td><strong>{pageData.manualHighlight?.suitable}</strong></td>
                        </tr>
                    ) : (
                        <tr><td>30 cm</td><td>{mn30}</td><td>10 meter</td><td>Rumah 1-2 lantai</td></tr>
                    )}
                    {pageData.diameterNum === 40 ? (
                        <tr class="row-highlight">
                            <td><strong>{pageData.manualHighlight?.diameter}</strong></td>
                            <td><strong>{pageData.manualHighlight?.price || mn40}</strong></td>
                            <td><strong>{pageData.manualHighlight?.maxDepth}</strong></td>
                            <td><strong>{pageData.manualHighlight?.suitable}</strong></td>
                        </tr>
                    ) : (
                        <tr><td>40 cm</td><td>{mn40}</td><td>10 meter</td><td>Ruko, kantor, bangunan 2 lantai</td></tr>
                    )}
                </tbody>
            </table>
        </div>
        {pageData.manualNote && <p class="price-hint" set:html={pageData.manualNote}></p>}
    </Fragment>
)}
</section>

                <a href="/jasa.html">Lihat Jasa Bore Pile & Strauss Pile untuk wilayah Anda →</a>

            <!-- ===== FAKTOR YANG MEMPENGARUHI HARGA ===== -->
            <section aria-labelledby="factors-heading">
                <h2 id="factors-heading" class="section-heading">Faktor yang Mempengaruhi Harga Bore Pile {pageData.diameter}</h2>

                <p><strong>Harga bore pile diameter {pageData.diameter} tidak sama untuk setiap proyek.</strong> Berikut faktor utama yang menyebabkan perbedaan biaya:</p>

                <div class="info-grid">
                    {pageData.factors.map(factor => (
                        <div class="info-card">
                            <h3>{factor.title}</h3>
                            <p>{factor.text}</p>
                        </div>
                    ))}
                </div>

                <div class="sondir-note" set:html={pageData.sondirNote}></div>
            </section>

            <!-- ===== ESTIMASI BIAYA TAMBAHAN ===== -->
            <section>
                <h2 class="section-heading-sm">Estimasi Biaya Tambahan</h2>
                <div class="info-grid">
                    {pageData.additionalCosts.map(cost => (
                        <div class="info-card"><h3>{cost.title}</h3><p set:html={cost.text}></p></div>
                    ))}
                </div>
            </section>

            <div class="tips-section">
                <h3 class="tips-heading">Tips memilih diameter:</h3>
                <ul>
                    {pageData.tips.map(tip => (
                        <li><strong>{tip.diameter}</strong> → {tip.usage}</li>
                    ))}
                </ul>
            </div>

            <!-- ===== CONTOH PROYEK NYATA ===== -->
            <section class="project-examples-section">
                <h2 class="project-heading">Contoh Hitungan Proyek Nyata Diameter {pageData.diameter}</h2>

                {pageData.projects.map(project => (
                    <div class="project-card">
                        <div class="project-row">
                            <div class="project-img">
                                {project.imageFallback ? (
                                    <img src={project.image} onerror={`this.src='${project.imageFallback}'; this.onerror=null;`}
                                         alt={project.imageAlt} 
                                         loading="lazy"
                                         data-lightbox>
                                ) : (
                                    <img src={project.image} 
                                         alt={project.imageAlt} 
                                         loading="lazy"
                                         data-lightbox>
                                )}
                                <div class="project-caption">{project.caption}</div>
                            </div>
                            {project.imageOnly ? null : (
                            <div class="project-text">
                                <div class="info-card">
                                    <h3>{project.title}</h3>
                                    <p>
                                    {project.specs && <Fragment><strong>Spesifikasi:</strong> {project.specs}<br/></Fragment>}
                                    {project.costCalc && <Fragment><strong>Biaya jasa:</strong> <span set:html={project.costCalc.replace(new RegExp('{m' + pageData.diameterNum + '}', 'g'), mesinPrice).replace(new RegExp('{mn' + pageData.diameterNum + '}', 'g'), manualPrice || '')}></span><br/></Fragment>}
                                    {project.mobilization && <Fragment><strong>+ mobilisasi:</strong> {project.mobilization}<br/></Fragment>}
                                    {project.total && <Fragment><strong>Total:</strong> <span set:html={project.total}></span><br/></Fragment>}
                                    {project.time && <Fragment><strong>Waktu:</strong> {project.time}</Fragment>}
                                    </p>
                                </div>
                            </div>
    )}
                        </div>
                    </div>
                ))}

                <div class="project-note">
                    <p set:html={pageData.projectNote}></p>
                </div>
            </section>

            <!-- ===== PERBANDINGAN DIAMETER ===== -->
            <section aria-labelledby="comparison-heading">
                <h2 id="comparison-heading" class="section-heading">{pageData.comparison.title}</h2>
                <p>{pageData.comparison.intro}</p>
                <div class="table-responsive">
                    <table class="price-table">
                        <caption>Perbandingan daya dukung dan harga antar diameter bore pile</caption>
                        <thead>
                            <tr><th>Diameter</th><th>Harga (Rp/m)</th><th>Daya Dukung</th><th>Cocok Untuk</th></tr>
                        </thead>
                        <tbody>
                            {pageData.comparison.rows.map((row, i) => (
                                <tr style={row.highlight ? "background:#fff3e0;" : (i % 2 === 0 ? "" : "background:#f9f9f9;")}>
                                    <td>{row.highlight ? <strong>{row.diameter}</strong> : row.diameter}</td>
                                    <td>{row.highlight ? <strong>{priceMap[`m${parseInt(row.diameter)}`]}</strong> : priceMap[`m${parseInt(row.diameter)}`]}</td>
                                    <td>{row.highlight ? <strong>{row.capacity}</strong> : row.capacity}</td>
                                    <td>{row.highlight ? <strong>{row.suitable}</strong> : row.suitable}</td>
                                </tr>
                            ))}
                        </tbody>
                    </table>
                </div>
                <p class="price-hint" style="text-align: left;" set:html={pageData.comparison.note}></p>
            </section>

            <!-- ===== KEUNTUNGAN ===== -->
            <section aria-labelledby="advantages-heading">
                <h2 id="advantages-heading" class="section-heading">Keuntungan Memilih Bore Pile Diameter {pageData.diameter}</h2>
                <div class="info-grid">
                    {pageData.advantages.map(adv => (
                        <div class="info-card"><h3>{adv.title}</h3><p>{adv.text}</p></div>
                    ))}
                </div>
            </section>

            <!-- ===== DAYA DUKUNG ===== -->
            <section aria-labelledby="capacity-heading">
                <h2 id="capacity-heading" class="section-heading">Daya Dukung Bore Pile Diameter {pageData.diameter}</h2>
                <div class="illustration-row">
                    <div class="illustration-img">
                        <img src={pageData.loadCapacity.image} alt={pageData.loadCapacity.imageAlt} loading="lazy" width="400" height="250">
                        <div class="caption">{pageData.loadCapacity.caption}</div>
                    </div>
                    <div class="illustration-text">
                        <p set:html={pageData.loadCapacity.intro}></p>
                        <ul>
                            {pageData.loadCapacity.items.map(item => (
                                <li set:html={item}></li>
                            ))}
                        </ul>
                        <p>{pageData.loadCapacity.conclusion}</p>
                    </div>
                </div>
            </section>

            <p>Butuh harga khusus untuk jasa bore pile di Jakarta? 
            <a href="/jasa/bore-pile/jakarta.html">Lihat jasa & harga bore pile Jakarta →</a>
            </p>

            <!-- ===== MATERIAL DARI KAMI ===== -->
            <section>
                <h2 class="section-heading">Bisa Pakai Material Dari Kami</h2>
                <p>Tidak ingin repot cari material sendiri? Agung Perkasa juga menyediakan paket lengkap jasa bor + material besi & beton:</p>
                <div class="info-grid">
                    <div class="info-card">
                        <h3>{pageData.materialPackage.diameter}</h3>
                        <p><strong>Harga :</strong> {pageData.materialPackage.price}<br>
                        <strong>Sudah termasuk:</strong> {pageData.materialPackage.includes}<br>
                        <strong>Minimal order:</strong> {pageData.materialPackage.minOrder}</p>
                    </div>
                </div>
                <p class="price-hint">{pageData.materialPackage.note}</p>
            </section>

            <!-- ===== KOMITMEN & GARANSI ===== -->
            <div class="commitment-box">
    <div class="icon" aria-hidden="true">🛡️</div>
    <p><strong>Komitmen & Garansi Mutu</strong><br>Kami memberikan garansi penuh atas kualitas dalam pengerjaan proyek. Kami menjamin kualitas terbaik karena didukung oleh tim ahli kami yang sangat berpengalaman membuat pondasi dalam (khususnya bore pile)</p>
</div>

                        <!-- ============================================================
                 WHY CHOOSE US & EQUIPMENT
                 ============================================================ -->
            <div class="why-section">
                <h2 class="why-title">Kenapa pilih Agung Perkasa untuk Bore Pile Diameter {pageData.diameter}?</h2>
                <p class="why-sub">Ini alasan kenapa banyak orang percaya sama Agung Perkasa untuk proyek bore pile diameter {pageData.diameter}.</p>

                <div class="reasons-grid">
                    {pageData.whyUs.map(item => (
                        <div class="reason-card">
                            <h3>{item.title}</h3>
                            <p>{item.desc}</p>
                        </div>
                    ))}
                </div>

                            <!-- ============================================================
                 PORTOFOLIO PROYEK
                 ============================================================ -->
            <section class="portfolio-jakarta-section">
                <h2 class="portfolio-jakarta-title">{pageData.portfolio.title}</h2>
                <p class="portfolio-jakarta-sub">{pageData.portfolio.subtitle}</p>

                <div class="proyek-jakarta-box">
                    <p class="proyek-jakarta-heading">{pageData.portfolio.heading}</p>
                    <div class="proyek-jakarta-grid">
                        {pageData.portfolio.items.map(item => (
                            <div class="proyek-jakarta-item">
                                <img src={item.image} 
                                     alt={item.imageAlt} 
                                     loading="lazy"
                                     width="400" height="300" data-lightbox>
                                <div class="proyek-jakarta-caption">
                                    <span class="proyek-jakarta-label">{item.label}</span>
                                    <span class="proyek-jakarta-detail">{item.detail}</span>
                                </div>
                            </div>
                        ))}
                    </div>
                    <p class="proyek-jakarta-link">
                        Ingin lihat lebih banyak? 
                        <a href="/galeri/gallery.html">Kunjungi galeri proyek kami →</a>
                    </p>
                </div>
            </section>

                <h3 class="equip-title">Alat yang Kami gunakan di lapangan</h3>
                <p class="equip-sub">Kami memiliki beberapa alat untuk pekerjaan bore pile diameter {pageData.diameter}, antara lain:</p>

                <div class="equip-grid">
                    {pageData.equipment.map(equip => (
                        <div class="equip-item">
                            <img class="equip-img" src={equip.image} 
                                 alt={equip.imageAlt} 
                                 loading="lazy">
                            <div class="equip-info">
                                <div class="equip-icon-inline">
                                    <img src="/imgs/logo-agung-perkasa.webp" alt={equip.logoAlt} width="24" height="24" onerror={`this.src='${equip.image}'`}>
                                    <h4>{equip.name}</h4>
                                </div>
                                <p>{equip.desc}</p>
                                <span class="equip-tag">Agung Perkasa</span>
                            </div>
                        </div>
                    ))}
                </div>
            </div>

            <!-- ===== FAQ ===== -->
            <section>
                <h2 class="section-heading">Pertanyaan Umum Seputar Bore Pile Diameter {pageData.diameter}</h2>
                <div class="faq-container">
                    {pageData.faq.map(item => (
                        <div class="faq-item">
                            <button class="faq-question">
                                {item.q}
                                <FaIcon class="fas fa-chevron-down" />
                            </button>
                            <div class="faq-answer">
                                <p set:html={item.a.replace(new RegExp('{m' + pageData.diameterNum + '}', 'g'), mesinPrice).replace(new RegExp('{mn' + pageData.diameterNum + '}', 'g'), manualPrice || '')}></p>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- ===== INTERNAL LINK ===== -->
            <div class="internal-link-box">
                <p><strong>Baca Juga Harga Bore Pile:</strong><br>
                {pageData.internalLinks.map((link, i) => (
                    <><a href={link.href}>{link.label}</a>{i < pageData.internalLinks.length - 1 ? ' | ' : ''}</>
                ))}
                </p>
            </div>

        
</KotaLayout>
