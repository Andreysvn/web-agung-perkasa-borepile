---
import config from '../../../../data/config.json';
import KotaLayout from '../../../../layouts/KotaLayout.astro';
import pricing from '../../../../data/harga.json';
import { organizationSchema, localBusinessSchema } from '../../../../lib/schema.js';
import FaIcon from '../../../../components/icons/FaIcon.astro';

// Components
import CityCalculator from '../../../../components/city/CityCalculator.astro';

const m30 = pricing.mesin.find(p => p.diameter === 30).price.toLocaleString('id-ID');
const m40 = pricing.mesin.find(p => p.diameter === 40).price.toLocaleString('id-ID');
const m50 = pricing.mesin.find(p => p.diameter === 50).price.toLocaleString('id-ID');
const mn20 = pricing.manual.find(p => p.diameter === 20).price.toLocaleString('id-ID');
const mn25 = pricing.manual.find(p => p.diameter === 25).price.toLocaleString('id-ID');
const mn30 = pricing.manual.find(p => p.diameter === 30).price.toLocaleString('id-ID');
const mn40 = pricing.manual.find(p => p.diameter === 40).price.toLocaleString('id-ID');

const orgLd = JSON.stringify(organizationSchema());

const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": `Jasa bore pile diameter 40cm terpercaya dengan pengalaman lebih dari 10 tahun. Harga bore pile mesin mulai Rp${m40}/m, manual mulai Rp${mn40}/m.`, 
    "areaServed": [
        { "@type": "City", "name": "Jakarta" },
        { "@type": "City", "name": "Bekasi" },
        { "@type": "City", "name": "Depok" },
        { "@type": "City", "name": "Tangerang" },
        { "@type": "City", "name": "Bogor" }
    ]
}));

const formattedUpdate = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));

const formattedMonthYear = new Intl.DateTimeFormat('id-ID', {
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));
---

<KotaLayout 
    title="Harga Bore Pile 40cm Terbaru 2026 Per Meter | Agung Perkasa"
    description={`Harga bore pile diameter 40cm terbaru 2026 seluruh Pulau Jawa. Mesin mulai Rp${m40}/m, manual Rp${mn40}/m. Kalkulator estimasi biaya. Konsultasi gratis.`}
    canonical="https://agungperkasaborepile.com/harga/bore-pile/40cm.html"
    schema={[orgLd, localBusinessLd]}
    extraCss={["/css/harga-komponen.css"]}
    faqSchema={[
        { q: "Apakah bore pile diameter 40cm cukup kuat untuk ruko 2-3 lantai?", a: "Sangat cukup. Dengan kedalaman 10-15 meter, diameter 40cm mampu menahan beban ruko dan kantor 2-3 lantai dengan aman. Daya dukungnya mencapai 25-40 ton." },
        { q: "Berapa standar harga jasa bor diameter 40cm?", a: "Standar harga jasa bor diameter 40cm: mesin Rp{m40}/m, manual sekitar Rp{mn40}/m karena jarang tukang bor manual yang ingin mengambil diameter tersebut (terlalu berat), harga tersebut hanya untuk jasa pengeboran, perakitan besi tulangan, dan pengecoran beton (belum termasuk material).\"" },
        { q: "Bisa pakai bore pile manual untuk diameter 40cm?", a: "Bisa. Bore pile manual bisa melayani diameter 40cm dengan kedalaman maksimal 10 meter. Harga lebih ekonomis, cocok untuk proyek kecil dan area terbatas dengan tanah padat." },
        { q: "Berapa jumlah titik ideal untuk bore pile diameter 40cm?", a: "Untuk ruko atau kantor dengan luas 150-300m², jumlah titik ideal antara 16-24 titik. Konsultasikan dengan tim teknis kami untuk perhitungan yang lebih akurat sesuai gambar bangunan Anda." },
        { q: "Apakah melayani area Bekasi, Tangerang, Bogor?", a: "Betul. Kami melayani area Jabodetabek (Jakarta, Bekasi, Bogor, Depok, Tangerang)." },
        { q: "Apakah melayani area luar Jabodetabek?", a: "Ya. Kami melayani seluruh area pulau Jawa sesuai permintaan proyek, tetapi ada perbedaan harga mobilisasi alat bore pile." },
        { q: "Berapa kedalaman maksimal bore pile diameter 40cm?", a: "Untuk bore pile mesin (mini crane) diameter 40cm, kedalaman maksimal mencapai 30 meter. Sedangkan untuk bore pile manual (strauss pile) diameter 40cm, kedalaman maksimal 10 meter. Kedalaman yang dibutuhkan tergantung pada kondisi tanah dan hasil uji sondir di lokasi proyek Anda. Semakin lunak tanah, semakin dalam pengeboran yang dibutuhkan hingga mencapai tanah keras." },
        { q: "Berapa biaya total bore pile 40cm untuk ruko 2 lantai?", a: "Untuk ruko 2 lantai dengan luas 150-300m², biasanya membutuhkan 16-24 titik bore pile diameter 40cm dengan kedalaman 10-15 meter. Estimasi biaya jasa bor (belum termasuk material): Mesin (Mini Crane): Rp{m40}/m × 12m × 20 titik = Rp32.400.000 + mobilisasi Rp2-3jt, Manual (Strauss Pile): Rp{mn40}/m × 8m × 20 titik = Rp19.200.000 + mobilisasi Rp1-1,5jt. Gunakan kalkulator di atas untuk menghitung estimasi biaya proyek Anda secara lebih akurat." }
    ]}
    breadcrumbItems={[
        { name: "Beranda", url: "/" },
        { name: "Harga", url: "/harga/bore-pile-2026.html" },
        { name: "Harga Bore Pile Diameter 40cm", url: "/harga/bore-pile/40cm.html" }
    ]}
>
            <nav class="breadcrumb" aria-label="Breadcrumb navigasi">
