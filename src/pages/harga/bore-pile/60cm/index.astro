---
import config from '../../../../data/config.json';
import KotaLayout from '../../../../layouts/KotaLayout.astro';
import pricing from '../../../../data/harga.json';
import { organizationSchema, localBusinessSchema } from '../../../../lib/schema.js';
import FaIcon from '../../../../components/icons/FaIcon.astro';

import CityCalculator from '../../../../components/city/CityCalculator.astro';

const m30 = pricing.mesin.find(p => p.diameter === 30)?.price.toLocaleString('id-ID') || '120.000';
const m40 = pricing.mesin.find(p => p.diameter === 40)?.price.toLocaleString('id-ID') || '135.000';
const m50 = pricing.mesin.find(p => p.diameter === 50)?.price.toLocaleString('id-ID') || '190.000';
const mn20 = pricing.manual.find(p => p.diameter === 20)?.price.toLocaleString('id-ID') || '75.000';
const mn25 = pricing.manual.find(p => p.diameter === 25)?.price.toLocaleString('id-ID') || '85.000';
const mn30 = pricing.manual.find(p => p.diameter === 30)?.price.toLocaleString('id-ID') || '100.000';
const mn40 = pricing.manual.find(p => p.diameter === 40)?.price.toLocaleString('id-ID') || '120.000';

const orgLd = JSON.stringify(organizationSchema());
const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": `Jasa bore pile diameter 60cm terpercaya dengan pengalaman lebih dari 10 tahun. Harga bore pile mesin mulai Rp${m50}/m untuk hotel dan gedung 4-5 lantai.`,
    "areaServed": [
        { "@type": "City", "name": "Jakarta" },
        { "@type": "City", "name": "Bekasi" },
        { "@type": "City", "name": "Depok" },
        { "@type": "City", "name": "Tangerang" },
        { "@type": "City", "name": "Bogor" }
    ]
}));

const formattedUpdate = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric', month: 'long', year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));

const formattedMonthYear = new Intl.DateTimeFormat('id-ID', {
    month: 'long', year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));
---
<KotaLayout 
    title="Harga Bore Pile 60cm Terbaru 2026 Per Meter | Agung Perkasa"
    description={`Harga bore pile diameter 60cm terbaru 2026 seluruh Pulau Jawa. Mesin mulai Rp${m50}/m. Kalkulator estimasi biaya proyek hotel 3-4 lantai. Konsultasi gratis.`}
    canonical="https://agungperkasaborepile.com/harga/bore-pile/60cm.html"
    schema={[orgLd, localBusinessLd]}
    extraCss={["/css/harga-komponen.css"]}
    faqSchema={[
        { q: "Apakah bore pile diameter 60cm cukup kuat untuk hotel 4 lantai?", a: "Sangat cukup. Dengan daya dukung 60-85 ton per titik, diameter 60cm mampu menahan beban hotel 4 lantai dengan aman. Bahkan untuk gedung 5 lantai pun masih kuat dengan kedalaman yang tepat berdasarkan data sondir." },
        { q: "Berapa standar harga jasa bor diameter 60cm?", a: "Harga jasa bor diameter 60cm: Hubungi Kami untuk mendapatkan penawaran harga terbaik sesuai kondisi proyek Anda. Harga dapat berbeda tergantung kedalaman pengeboran dan kondisi tanah." },
        { q: "Berapa kedalaman maksimal bore pile diameter 60cm?", a: "Untuk bore pile mesin (mini crane/gawangan) diameter 60cm, kedalaman maksimal mencapai 30 meter. Sedangkan untuk bore pile manual (strauss pile) diameter 60cm, kedalaman maksimal 10 meter. Kedalaman yang dibutuhkan tergantung pada kondisi tanah dan hasil uji sondir di lokasi proyek Anda." },
        { q: "Berapa jumlah titik ideal untuk bore pile diameter 60cm?", a: "Untuk hotel atau gedung dengan luas 400-800m&#xB2;, jumlah titik ideal antara 25-50 titik. Konsultasikan dengan tim teknis kami untuk perhitungan yang akurat sesuai gambar bangunan." },
        { q: "Apakah bore pile diameter 60cm bisa dikerjakan manual?", a: "Bisa, namun terbatas. Bore pile manual (strauss pile) untuk diameter 60cm hanya bisa dikerjakan dengan kedalaman maksimal 10 meter dan hanya untuk area terbatas. Untuk kedalaman lebih dari 10 meter, kami rekomendasikan menggunakan mesin." },
        { q: "Apakah melayani area Bekasi, Tangerang, Bogor?", a: "Betul. Kami melayani area Jabodetabek (Jakarta, Bekasi, Bogor, Depok, Tangerang) untuk proyek diameter 60cm." },
        { q: "Apakah melayani area luar Jabodetabek?", a: "Ya. Kami melayani seluruh area pulau Jawa untuk proyek skala besar dengan diameter 60cm." },
        { q: "Berapa biaya total bore pile 60cm untuk hotel 4 lantai?", a: "Untuk hotel 4 lantai dengan luas 400-800m&#xB2;, biasanya membutuhkan 25-40 titik bore pile diameter 60cm dengan kedalaman 15-20 meter. Estimasi biaya jasa bor (belum termasuk material): Mesin (Mini Crane): Rp{m50}/m &#x00D7; 15m &#x00D7; 30 titik = estimasi Rp{m50}/m &#x00D7; 450m + mobilisasi Rp2-3jt. Gunakan kalkulator di atas untuk menghitung estimasi biaya proyek Anda secara lebih akurat." }
    ]}
    breadcrumbItems={[
        { name: "Beranda", url: "/" },
        { name: "Harga", url: "/harga/bore-pile-2026.html" },
        { name: "Harga Bore Pile Diameter 60cm", url: "/harga/bore-pile/60cm.html" }
    ]}
