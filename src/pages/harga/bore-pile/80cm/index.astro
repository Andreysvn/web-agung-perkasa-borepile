---
import config from '../../../../data/config.json';
import KotaLayout from '../../../../layouts/KotaLayout.astro';
import pricing from '../../../../data/harga.json';
import { organizationSchema, localBusinessSchema } from '../../../../lib/schema.js';
import FaIcon from '../../../../components/icons/FaIcon.astro';

import CityCalculator from '../../../../components/city/CityCalculator.astro';

const m30 = pricing.mesin.find(p => p.diameter === 30)?.price.toLocaleString('id-ID') || '120.000';
const m40 = pricing.mesin.find(p => p.diameter === 40)?.price.toLocaleString('id-ID') || '135.000';
const m50 = pricing.mesin.find(p => p.diameter === 50)?.price.toLocaleString('id-ID') || '190.000';
const mn20 = pricing.manual.find(p => p.diameter === 20)?.price.toLocaleString('id-ID') || '75.000';
const mn25 = pricing.manual.find(p => p.diameter === 25)?.price.toLocaleString('id-ID') || '85.000';
const mn30 = pricing.manual.find(p => p.diameter === 30)?.price.toLocaleString('id-ID') || '100.000';
const mn40 = pricing.manual.find(p => p.diameter === 40)?.price.toLocaleString('id-ID') || '120.000';

const orgLd = JSON.stringify(organizationSchema());

const localBusinessLd = JSON.stringify(localBusinessSchema({
    "description": "Jasa bore pile diameter 80cm terpercaya dengan pengalaman lebih dari 10 tahun. Harga bore pile mesin mulai dari Rp70.000/m untuk gedung 5-8 lantai. Konsultasi gratis.",
    "areaServed": [
        { "@type": "City", "name": "Jakarta" },
        { "@type": "City", "name": "Bekasi" },
        { "@type": "City", "name": "Depok" },
        { "@type": "City", "name": "Tangerang" },
        { "@type": "City", "name": "Bogor" }
    ],
    "priceRange": "Rp70.000 - Rp350.000"
}));

const formattedUpdate = new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));

const formattedMonthYear = new Intl.DateTimeFormat('id-ID', {
    month: 'long',
    year: 'numeric'
}).format(new Date(`${pricing.priceUpdatedAt}T00:00:00`));

const faqSchema = [
    {
        question: "Apakah bore pile diameter 80cm cukup kuat untuk gedung 8 lantai?",
        answer: "Sangat cukup. Dengan daya dukung 100-150 ton per titik dan kedalaman 15-25 meter, diameter 80cm mampu menahan beban gedung 5-8 lantai dengan aman. Bahkan untuk gedung 10 lantai pun masih kuat dengan perhitungan struktur yang tepat."
    },
    {
        question: "Berapa standar harga jasa bor diameter 80cm?",
        answer: "Standar harga jasa bor diameter 80cm: Hubungi Kami untuk mendapatkan penawaran harga terbaik sesuai kondisi proyek Anda. Harga dapat berbeda tergantung kedalaman pengeboran dan kondisi tanah."
    },
    {
        question: "Berapa kedalaman maksimal bore pile diameter 80cm?",
        answer: "Untuk bore pile mesin (mini crane & gawangan) diameter 80cm, kedalaman maksimal mencapai 30 meter. Kedalaman yang dibutuhkan tergantung pada kondisi tanah dan hasil uji sondir di lokasi proyek Anda."
    },
    {
        question: "Berapa jumlah titik ideal untuk bore pile diameter 80cm?",
        answer: "Untuk gedung dengan luas 500-1000m\u00B2, jumlah titik ideal antara 25-50 titik. Konsultasikan dengan tim teknis kami untuk perhitungan yang akurat sesuai gambar bangunan."
    },
    {
        question: "Apakah melayani area Bekasi, Tangerang, Bogor?",
        answer: "Betul. Kami melayani area Jabodetabek (Jakarta, Bekasi, Bogor, Depok, Tangerang) untuk proyek diameter 80cm dengan alat berat yang memadai."
    },
    {
        question: "Apakah melayani area luar Jabodetabek?",
        answer: "Ya. Kami melayani seluruh area pulau Jawa untuk proyek skala besar dengan diameter 80cm, dengan biaya mobilisasi yang disesuaikan."
    },
    {
        question: "Berapa biaya total bore pile 80cm untuk gedung 6 lantai?",
        answer: "Untuk gedung 6 lantai dengan luas 500-800m\u00B2, biasanya membutuhkan 25-40 titik bore pile diameter 80cm dengan kedalaman 15-20 meter. Estimasi biaya jasa bor (belum termasuk material): Hubungi Kami untuk penawaran terbaik. Gunakan kalkulator di halaman untuk perhitungan lebih akurat."
    },
    {
        question: "Apakah ada estimasi waktu pengerjaan bore pile 80cm?",
        answer: "Untuk proyek bore pile 80cm, estimasi waktu pengerjaan tergantung jumlah titik dan kedalaman. Biasanya 10-14 hari kerja untuk 25-40 titik. Hubungi kami untuk jadwal dan estimasi yang lebih akurat."
