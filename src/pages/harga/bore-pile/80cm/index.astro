    description="Harga bore pile diameter 80cm terbaru 2026 seluruh Pulau Jawa. Kalkulator estimasi biaya proyek gedung 5-8 lantai. Konsultasi gratis."
    canonical="https://agungperkasaborepile.com/harga/bore-pile/80cm.html"
    schema={[orgLd, localBusinessLd]}
    extraCss={["/css/harga-komponen.css"]}
    faqSchema={faqSchema.map(f => ({ q: f.question, a: f.answer }))}
    breadcrumbItems={[
        { name: "Beranda", url: "/" },
        { name: "Harga", url: "/harga/bore-pile-2026.html" },
        { name: "Harga Bore Pile Diameter 80cm", url: "/harga/bore-pile/80cm.html" }
    ]}
>
            <nav class="breadcrumb" aria-label="Breadcrumb navigasi">
                <a href="/">Beranda</a>
                <span class="separator">/</span>
                <a href="/harga/bore-pile-2026.html">Harga</a>
                <span class="separator">/</span>
