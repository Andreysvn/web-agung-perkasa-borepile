                                <td><span class="text-konsultasi">Hubungi Kami</span></td>
                                <td><strong>30 meter</strong></td>
                                <td><strong>Gedung 5-8 lantai, apartemen, hotel, rumah sakit</strong></td>
                            </tr>
                        </tbody>
                    </table>
                </div>

